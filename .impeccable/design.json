  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action of a view.",
      "html": "<button class=\"ds-btn-primary\">Create bot</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:1px solid transparent;border-radius:6px;font:500 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,color .15s;background:var(--primary,#015A45);color:var(--primary-foreground,#FFFFFF)}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary,#015A45),var(--foreground,#18181B) 12%)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring,#015A45);outline-offset:2px}.ds-btn-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Card fill with a 3:1 control edge; the default for non-primary actions.",
      "html": "<button class=\"ds-btn-secondary\">Cancel</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:1px solid transparent;border-radius:6px;font:500 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,color .15s;background:var(--card,#FFFFFF);border-color:var(--input,#8A8A93);color:var(--foreground,#18181B)}.ds-btn-secondary:hover{background:var(--muted,#F0F0F3)}.ds-btn-secondary:focus-visible{outline:2px solid var(--ring,#015A45);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "No fill at rest; a quiet fill on hover.",
      "html": "<button class=\"ds-btn-ghost\">Show 4 more</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:1px solid transparent;border-radius:6px;font:500 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,color .15s;padding:0 8px;background:transparent;color:var(--foreground,#18181B)}.ds-btn-ghost:hover{background:var(--accent,#EDEDF0)}.ds-btn-ghost:focus-visible{outline:2px solid var(--ring,#015A45);outline-offset:2px}"
    },
    {
      "name": "Destructive Button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "A 10% tint with destructive text, never a solid fill.",
      "html": "<button class=\"ds-btn-danger\">Delete chat</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:1px solid transparent;border-radius:6px;font:500 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color .15s,color .15s;background:color-mix(in srgb,var(--destructive,#8A1818) 10%,transparent);color:var(--destructive,#8A1818)}.ds-btn-danger:hover{background:color-mix(in srgb,var(--destructive,#8A1818) 20%,transparent)}.ds-btn-danger:focus-visible{outline:2px solid var(--ring,#015A45);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "32px field on the card fill with a 3:1 edge.",
      "html": "<input class=\"ds-input\" placeholder=\"Filter rooms, bots and chats\" aria-label=\"Filter\">",
      "css": ".ds-input{height:32px;width:240px;padding:0 12px;border:1px solid var(--input,#8A8A93);border-radius:6px;background:var(--card,#FFFFFF);color:var(--foreground,#18181B);font:400 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;outline:none;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:var(--muted-foreground,#4A4A52)}.ds-input:focus-visible{border-color:var(--ring,#015A45);box-shadow:0 0 0 1px var(--ring,#015A45)}"
    },
    {
      "name": "Badges",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Neutral, attention and status badges; status pairs a tint with an icon.",
      "html": "<span class=\"ds-badges\"><span class=\"ds-badge\">Draft</span><span class=\"ds-badge ds-badge-att\">3</span><span class=\"ds-badge ds-badge-fail\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v5M12 16h.01\"/></svg>Blocked</span></span>",
      "css": ".ds-badges{display:inline-flex;gap:8px}.ds-badge{display:inline-flex;align-items:center;gap:4px;height:20px;padding:0 8px;border-radius:4px;background:var(--muted,#F0F0F3);color:var(--foreground,#18181B);font:500 12px/16px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;white-space:nowrap}.ds-badge-att{padding:0 6px;background:var(--attention,#F0A63A);color:var(--attention-foreground,#2B1A00);font-variant-numeric:tabular-nums}.ds-badge-fail{background:color-mix(in srgb,var(--destructive,#8A1818) 10%,transparent);color:var(--destructive,#8A1818)}"
    },
    {
      "name": "Sidebar Rows",
      "kind": "nav",
      "refersTo": "sidebar-row",
      "description": "28px rows; selected is the hover fill plus an emerald icon, no side stripe.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><div class=\"ds-nav-label\">Bots</div><a class=\"ds-row\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"4\"/></svg><span class=\"ds-row-label\">Chief</span><span class=\"ds-row-meta\">1d</span></a><a class=\"ds-row ds-row-active\" href=\"#\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h10\"/></svg><span class=\"ds-row-label\">Inbox</span><span class=\"ds-badge-att\">3</span></a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;width:224px;padding:8px;background:var(--sidebar,#F3F3F5);font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif}.ds-nav-label{padding:16px 8px 4px;font:500 12px/16px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;color:var(--muted-foreground,#4A4A52)}.ds-row{display:flex;align-items:center;gap:8px;height:28px;padding:0 8px;border-radius:6px;color:var(--foreground,#18181B);font:500 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;text-decoration:none;transition:background-color .15s}.ds-row svg{color:var(--muted-foreground,#4A4A52);flex-shrink:0}.ds-row:hover{background:var(--accent,#EDEDF0)}.ds-row:focus-visible{outline:2px solid var(--ring,#015A45)}.ds-row-active{background:var(--accent,#EDEDF0)}.ds-row-active svg{color:var(--primary,#015A45)}.ds-row-label{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-row-meta{font-size:12px;color:var(--muted-foreground,#4A4A52);font-variant-numeric:tabular-nums}.ds-badge-att{border-radius:4px;padding:0 6px;background:var(--attention,#F0A63A);color:var(--attention-foreground,#2B1A00);font:500 12px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "Card fill, 12px radius, hairline edge; the send button is a 28px emerald circle.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-composer-text\" rows=\"2\" placeholder=\"Message Writer…\" aria-label=\"Message\"></textarea><div class=\"ds-composer-bar\"><button class=\"ds-composer-tool\" aria-label=\"Attach\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M21 12.5 12.5 21a5 5 0 0 1-7-7L14 5.5a3.5 3.5 0 0 1 5 5L10.5 19a2 2 0 0 1-3-3L15 8.5\"/></svg></button><button class=\"ds-composer-send\" aria-label=\"Send\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg></button></div></div>",
      "css": ".ds-composer{width:480px;border:1px solid var(--border,#E2E2E6);border-radius:12px;background:var(--card,#FFFFFF);font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif}.ds-composer:focus-within{border-color:var(--ring,#015A45)}.ds-composer-text{display:block;width:100%;min-height:40px;padding:8px 12px;border:0;background:transparent;color:var(--foreground,#18181B);font:400 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;resize:none;outline:none}.ds-composer-text::placeholder{color:var(--muted-foreground,#4A4A52)}.ds-composer-bar{display:flex;justify-content:space-between;align-items:center;padding:4px 8px 8px}.ds-composer-tool{display:grid;place-items:center;width:28px;height:28px;border:0;border-radius:6px;background:transparent;color:var(--muted-foreground,#4A4A52);cursor:pointer}.ds-composer-tool:hover{background:var(--accent,#EDEDF0);color:var(--foreground,#18181B)}.ds-composer-send{display:grid;place-items:center;width:28px;height:28px;border:0;border-radius:999px;background:var(--primary,#015A45);color:var(--primary-foreground,#FFFFFF);cursor:pointer}.ds-composer-send:hover{background:color-mix(in oklch,var(--primary,#015A45),var(--foreground,#18181B) 12%)}.ds-composer-tool:focus-visible,.ds-composer-send:focus-visible{outline:2px solid var(--ring,#015A45);outline-offset:2px}"
    },
    {
      "name": "Message Row",
      "kind": "custom",
      "description": "Flat message row, not a bubble: 32px avatar, name and time on one line, then the body.",
      "html": "<article class=\"ds-msg\"><span class=\"ds-msg-avatar\" aria-hidden=\"true\">A</span><div><div class=\"ds-msg-head\"><span class=\"ds-msg-name\">Ana</span><time class=\"ds-msg-time\">09:41</time></div><p class=\"ds-msg-body\">Draft the weekly brief from yesterday's notes. Use <code class=\"ds-code\">notes.md</code>.</p></div></article>",
      "css": ".ds-msg{display:flex;gap:12px;max-width:768px;padding:8px 16px;background:var(--background,#FBFBFC);color:var(--foreground,#18181B);font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif}.ds-msg:hover{background:color-mix(in oklch,var(--muted,#F0F0F3) 50%,var(--background,#FBFBFC))}.ds-msg-avatar{display:grid;place-items:center;flex-shrink:0;width:32px;height:32px;border-radius:999px;background:var(--muted,#F0F0F3);font:600 12px 'Geist Variable',ui-sans-serif,system-ui,sans-serif}.ds-msg-head{display:flex;align-items:baseline;gap:8px}.ds-msg-name{font:500 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif}.ds-msg-time{font:500 12px/16px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;color:var(--muted-foreground,#4A4A52);font-variant-numeric:tabular-nums}.ds-msg-body{margin:0;font:400 14px/20px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;text-wrap:pretty}.ds-code{padding:0 4px;border:1px solid var(--border,#E2E2E6);border-radius:4px;background:color-mix(in oklch,var(--foreground,#18181B) 6%,transparent);font:400 12px 'Geist Mono Variable',ui-monospace,monospace}"
    }
  ],
  "narrative": {
    "northStar": "Talk to the right bot, in the right chat.",
    "overview": "**Creative North Star: \"Talk to the right bot, in the right chat.\"**\n\nZetta is a chat workspace for bots. It works like Slack, with one change: each bot has many chats. A user starts a new chat for each intention, so the bot keeps a clean context and the user can find the work again. The chief is the first bot; the other bots follow in the order that the user sets.\n\nThe visual reference is Linear: a quiet gray ground, one content panel, dense rows, fast keyboard paths, and no decoration. The interface stays still while bots work. Two colors speak: emerald marks what the user can act on or has selected, and amber marks the places where a person is needed.",
    "keyCharacteristics": [
      "Cool, low-chroma neutrals in light and dark themes. One emerald signal. Amber only for attention.",
      "WCAG 2.2 AA, with AAA color contrast: every text and background pair is 7:1 or more (PRODUCT.md). Non-text indicators (input borders, focus rings, icons that carry meaning) are 3:1 or more. Focus rings are always visible.",
      "All sizes and spaces are even pixel values on a 4px grid. Base text is 14px.",
      "Flat at rest. Depth comes from surface tone and 1px borders; only floating layers have shadows.",
      "Every color comes from a semantic token. A new color scheme is a new set of values for the same tokens."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Emerald marks the thing to act on or the selected thing. It never decorates, and it never means \"success\".",
        "section": "colors"
      },
      {
        "name": "The Attention Rule",
        "body": "Amber means \"a person is needed\" and nothing else. It is the loudest thing on screen.",
        "section": "colors"
      },
      {
        "name": "The Tint Not Fill Rule",
        "body": "Failed and blocked states are a 10% tint with colored text and an icon, never a solid fill, so a failure does not out-shout a request for the user.",
        "section": "colors"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Cards, lists, rows and panels have no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use only the semantic tokens; change token values, never add tokens.",
      "**Do** check every new theme or color change against the contrast table (7:1 text, 3:1 non-text).",
      "**Do** use even pixel values on the 4px grid, with 14px base text.",
      "**Do** keep emerald for actions and selection, and amber for \"a person is needed\".",
      "**Do** give every drag a keyboard alternative and every icon-only button an `aria-label`.",
      "**Do** use TanStack Router `<Link>` for in-app navigation (see CLAUDE.md).",
      "**Do** use the shared `@zetta/ui` and `@g4rcez/components` primitives before you build new ones."
    ],
    "donts": [
      "**Don't** use raw hex, Tailwind palette colors or `--var-*` tokens in components.",
      "**Don't** add a lighter third text gray, a second accent hue, or a gradient.",
      "**Don't** put shadows on cards, lists or panels, or side stripes on rows.",
      "**Don't** use uppercase mono labels, text below 12px, or odd pixel values.",
      "**Don't** copy Linear's or any competitor's logo, text, illustrations or exact layouts.",
      "**Don't** show technical words (harness, MCP, hook) in default views.",
      "**Don't** let color alone carry a state; add an icon or a word."
    ]
  }
}
