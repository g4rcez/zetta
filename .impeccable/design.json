      },
      "body": {
        "displayName": "Body",
        "purpose": "Default UI text and chat messages; the 14px base. Weight 500 for sidebar rows, author names and buttons."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Group labels (sentence case, sans), badges, timestamps, helper text. The smallest size."
      },
      "code": {
        "displayName": "Code",
        "purpose": "Code blocks, inline code, keycaps and identifiers; Geist Mono only."
      }
    },
    "shadows": [
      {
        "name": "float",
        "value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
        "purpose": "Menus, popovers, command palette and the dragged row, always with a 1px --border."
      },
      {
        "name": "sheet",
        "value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
        "purpose": "Sheets and dialogs."
      },
      {
        "name": "overlay",
        "value": "oklch(0 0 0 / 60%)",
        "purpose": "Scrim behind sheets and dialogs (a background, not a box-shadow)."
      }
    ],
    "motion": [
      {
        "name": "feedback",
        "value": "150ms",
        "purpose": "Hover and press color feedback (CSS transitions, the Tailwind default)."
      },
      {
        "name": "overlay-in",
        "value": "100ms fade + zoom-95, 8px slide from the trigger side",
        "purpose": "Popovers and menus opening."
      },
      {
        "name": "expand",
        "value": "160ms easeOut, opacity + 4px y",
        "purpose": "A bot's chats entering when the row expands; rows below move with layout."
      },
      {
        "name": "panel",
        "value": "200ms easeOut, opacity + 8px x",
        "purpose": "The 360px context panel arriving."
      },
      {
        "name": "sheet-slide",
        "value": "200ms ease-in-out, 2.5rem offset; overlay 150ms fade",
        "purpose": "Sheets entering and leaving."
      },
      {
        "name": "reorder-spring",
        "value": "spring stiffness 600, damping 40",
        "purpose": "Bot rows moving aside during drag reorder (motion Reorder, layout)."
      },
      {
        "name": "reduced",
        "value": "duration 0; opacity only",
        "purpose": "prefers-reduced-motion: layout changes are instant."
      }
    ],
    "breakpoints": [
