  "narrative": {
    "northStar": "The Quiet Dispatcher",
    "overview": "Work happens on the server; the interface stays still until something needs the user. Zetta reads as a calm control room: indigo-tinted neutrals, one violet accent, hairline structure, and no decoration competing with bot output or attention states. When a bot is working, nothing should shout; when a person is needed, that is the loudest thing on screen.",
    "keyCharacteristics": [
      "Cool indigo-tinted neutrals (hue 265) with a single violet accent (hue 275).",
      "Flat, tonal layering; depth from 1px rings and surface tint, not shadows.",
      "Light and dark themes with equal standing (class-based .dark).",
      "Dense, scannable app chrome at 14px body.",
      "WCAG 2.2 AA is a requirement; focus rings are always visible."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Signal Violet marks the thing you can act on or that is selected. It never decorates.",
        "section": "colors"
      },
      {
        "name": "The Tint Not Fill Rule",
        "body": "Danger and attention states use a low-opacity tint with colored text, never a saturated fill.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Do not add a second typeface. Differentiate with weight and size.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Cards, lists and panels carry no shadow. If something needs lifting, it should be a floating layer.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the token variables (--primary, --border, etc.) rather than raw colors so both themes stay in step.",
      "Do keep Signal Violet to actionable and selected elements.",
      "Do give every interactive element a visible focus treatment (violet border plus 1px ring).",
      "Do express danger as a tint plus colored text.",
      "Do use the shared @zetta/ui components before building new primitives."
    ],
    "donts": [
      "Don't add shadows to cards, lists or panels.",
      "Don't introduce a second typeface or a second accent hue.",
      "Don't use raw hex or Tailwind palette colors where a token exists.",
      "Don't surface technical vocabulary (harness, MCP, hook) in default-visible UI.",
      "Don't let status color alone carry meaning; pair it with text or an icon."
    ]
  }
