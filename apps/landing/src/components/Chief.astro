---
// Zetta as the chief of the bots. Three parts: the heading with a small org chart (the robot on top, the bots it manages below),
// six things the chief manages (each one is a real chief tool, see apps/server/src/modules/chat/chief), and the chat where it
// proposes a bot and waits for an Approve. The chart and the chat are illustrations in HTML; the flow is the product's own:
// the chief's writes are Approve cards, and secrets go through a form, never through the chat.
import BotArt from "./BotArt.astro";
import Logo from "./Logo.astro";
import { getCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale).chief;

// Line icons, 24x24, drawn with a stroke. One for each capability id in src/locales (chief.caps).
const ICONS: Record<string, string> = {
  bot: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>',
  team: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  routine: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  tools: '<path d="M12 22v-5M9 8V2M15 8V2M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/>',
  room: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  secrets: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
};
---

<section class="section chief" id="chief" aria-labelledby="chief-title">
  <div class="wrap">
    <div class="top">
      <div class="sec-head rv">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="chief-title">{t.title.before}<em>{t.title.mark}</em>{t.title.after}</h2>
        <p class="lead">{t.lead}</p>
      </div>

      <div class="org rv" role="img" aria-label={t.orgAlt}>
        <div class="boss">
          <Logo tile size={96} id="chief-org" />
          <span class="badge">{t.badge}</span>
          <small>{t.role}</small>
        </div>
        <ul class="crew">
          {
            t.crew.map((bot) => (
              <li class:list={["mate", bot.tone]}>
                <BotArt name={bot.name} size={48} />
                <b>{bot.name}</b>
                <span class="state">{bot.state}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <h3 class="caps-title rv">{t.capsTitle}</h3>
    <ul class="caps">
      {
        t.caps.map((cap) => (
          <li class="cap rv">
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={ICONS[cap.id]} />
            </span>
            <b>{cap.title}</b>
            <span>{cap.body}</span>
          </li>
        ))
      }
    </ul>

    <div class="grid">
      <div class="chat rv" role="img" aria-label={t.alt}>
        <div class="msg you"><span>{t.ask}</span></div>
        <div class="msg bot">
          <span class="face" aria-hidden="true"><Logo tile size={34} id="chief-chat" /></span>
          <div class="body">
            <p>{t.reply}</p>
            <div class="proposal">
              <div class="who">
                <BotArt name={t.proposal.name} size={44} />
                <div>
                  <b>{t.proposal.name}</b>
                  <small>{t.proposal.kind}</small>
                </div>
              </div>
              <dl>
                {
                  t.proposal.fields.map((f) => (
                    <div>
                      <dt>{f.label}</dt>
                      <dd>{f.value}</dd>
                    </div>
                  ))
                }
              </dl>
              <div class="buttons" aria-hidden="true">
                <span class="btn btn-primary btn-sm">{t.proposal.approve}</span>
                <span class="btn btn-sm">{t.proposal.edit}</span>
                <span class="btn btn-sm btn-ghost">{t.proposal.decline}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <ul class="points rv">
        {
          t.points.map((p) => (
            <li>
              <b>{p.title}</b>
              <span>{p.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: 56px 80px;
    align-items: center;
  }

  /* ---- the org chart: the chief on top, a line down to each bot ---- */
  .org {
    --line: color-mix(in srgb, var(--primary) 38%, transparent);
    display: grid;
    gap: 36px;
    padding: 32px 24px 28px;
    border-radius: var(--radius-3xl);
    background: var(--sidebar);
    box-shadow: 0 0 0 1px rgb(24 24 27 / 0.06);
  }
  .boss {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 4px;
  }
  .boss small {
    color: var(--muted-foreground);
    font-size: 13px;
    line-height: 18px;
  }
  .badge {
    margin-top: 6px;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 13px;
    font-weight: 600;
    line-height: 20px;
  }
  /* The stem from the chief down to the bar. */
  .boss::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    width: 2px;
    height: 18px;
    background: var(--line);
    transform-origin: top;
    transition: transform 500ms var(--ease) 200ms;
  }
  .crew {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  /* The bar over the four bots, from the middle of the first to the middle of the last. */
  .crew::before {
    content: "";
    position: absolute;
    top: -18px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: var(--line);
    transition: transform 700ms var(--ease) 500ms;
  }
  .mate {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
  }
  .mate::before {
    content: "";
    position: absolute;
    bottom: 100%;
    left: 50%;
    width: 2px;
    height: 18px;
    margin-bottom: 0;
    background: var(--line);
    transform-origin: top;
    transition: transform 400ms var(--ease) 1000ms;
  }
  .mate b {
    font-size: 15px;
    line-height: 20px;
  }
  .state {
    padding: 1px 10px;
    border-radius: 999px;
    background: var(--card);
    box-shadow: 0 0 0 1px rgb(24 24 27 / 0.1);
    color: var(--foreground);
    font-size: 12px;
    font-weight: 560;
    line-height: 20px;
    white-space: nowrap;
  }
  .working .state {
    background: var(--primary-soft);
    color: var(--primary);
    box-shadow: none;
  }
  .needs .state {
    background: var(--attention);
    color: var(--attention-foreground);
    box-shadow: none;
  }
  /* The lines draw in when the chart scrolls into view. */
  :global(.js) .org:not(.in) .boss::after,
  :global(.js) .org:not(.in) .mate::before {
    transform: scaleY(0);
  }
  :global(.js) .org:not(.in) .crew::before {
    transform: scaleX(0);
  }

  /* ---- what the chief manages ---- */
  .caps-title {
    margin-top: 96px;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .caps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }
  .cap {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 6px;
    padding: 24px;
    border-radius: var(--radius-2xl);
    background: var(--card);
    box-shadow: 0 0 0 1px rgb(24 24 27 / 0.08);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 8px;
    border-radius: 14px;
    background: var(--primary-soft);
    color: var(--primary);
  }
  .cap b {
    font-size: 17px;
    line-height: 24px;
    letter-spacing: -0.02em;
  }
  .cap > span:last-child {
    color: var(--muted-foreground);
    font-size: 15px;
    line-height: 22px;
  }

  /* ---- the chat where it proposes a bot ---- */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 56px 88px;
    align-items: center;
    margin-top: 72px;
  }
  .chat {
    display: grid;
    gap: 18px;
    padding: 28px;
    border-radius: 32px;
    background: var(--sidebar);
    box-shadow: 0 0 0 1px rgb(24 24 27 / 0.06);
  }
  .msg {
    display: flex;
    gap: 12px;
    max-width: 100%;
  }
  .you {
    justify-self: end;
    max-width: 82%;
  }
  .you span {
    padding: 12px 16px;
    border-radius: 20px 20px 6px 20px;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 15px;
    line-height: 22px;
  }
  .face {
    flex: none;
    display: block;
  }
  .body {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .body > p {
    font-size: 15px;
    line-height: 22px;
  }
  .proposal {
    display: grid;
    gap: 16px;
    padding: 20px;
    border-radius: 20px;
    background: var(--card);
    box-shadow:
      0 0 0 1px rgb(24 24 27 / 0.08),
      0 24px 40px -28px rgb(20 24 29 / 0.5);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .who b {
    display: block;
    font-size: 17px;
    line-height: 22px;
    letter-spacing: -0.02em;
  }
  .who small {
    display: block;
    color: var(--muted-foreground);
    font-size: 13px;
    line-height: 18px;
  }
  dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 12px;
    font-size: 14px;
    line-height: 20px;
  }
  dt {
    color: var(--muted-foreground);
  }
  dd {
    margin: 0;
    font-weight: 560;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .buttons .btn {
    cursor: default;
  }
  .buttons .btn:hover {
    transform: none;
  }
  .points {
    display: grid;
    gap: 20px;
  }
  .points li {
    position: relative;
    display: grid;
    gap: 2px;
    padding-left: 28px;
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brand);
  }
  .points b {
    font-size: 17px;
    line-height: 24px;
  }
  .points span {
    color: var(--muted-foreground);
    font-size: 16px;
    line-height: 24px;
  }

  @media (max-width: 1080px) {
    .top,
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .caps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .caps {
      grid-template-columns: minmax(0, 1fr);
    }
    .org {
      padding-inline: 12px;
    }
    .crew {
      gap: 4px;
    }
    .state {
      padding-inline: 6px;
      font-size: 11px;
    }
    .chat {
      padding: 16px;
    }
    dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .org:not(.in) .boss::after,
    :global(.js) .org:not(.in) .mate::before,
    :global(.js) .org:not(.in) .crew::before {
      transform: none;
    }
  }
</style>
