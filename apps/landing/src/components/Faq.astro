---
import { getCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale).faq;
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="head">
      <h2>{t.title}</h2>
    </div>
    <div class="items">
      {t.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .items {
    max-width: 760px;
    margin-inline: auto;
    border-bottom: 1px solid var(--border);
  }
  details {
    border-top: 1px solid var(--border);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    font-size: 17px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    flex: none;
    color: var(--muted-foreground);
    font-size: 24px;
    line-height: 24px;
  }
  details[open] summary::after {
    content: "−";
  }
  details p {
    max-width: 60ch;
    padding-bottom: 20px;
    color: var(--muted-foreground);
  }
</style>
