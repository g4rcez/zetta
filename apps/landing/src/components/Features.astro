---
// The three lead features carry a small scene built from the app's own pieces (bot faces, rows, badges) and real copy.
// The scenes are illustrations, so each is one image for assistive tech; the card's heading and text carry the meaning.
import Logo from "./Logo.astro";
import BotArt from "./BotArt.astro";
import Brand from "./Brand.astro";
import { CAST } from "../cast";
import { getCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const copy = getCopy(Astro.props.locale);
const t = copy.features;
const sc = t.scenes;
const illustrated = copy.demo.illustrated;
const today = 2;
---

<section class="section band" id="features">
  <div class="wrap">
    <div class="head">
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <ul class="grid lead-cards">
      {t.items.slice(0, 3).map((item, i) => (
        <li>
          {i === 0 ? (
            <div class="scene" role="img" aria-label={`${item.title}. ${illustrated}.`}>
              <div class="side">
                <p class="line bot"><BotArt name={CAST.writer.name} size={24} /><b>{CAST.writer.name}</b></p>
                {sc.chats.map((chat, n) => <p class:list={["line", "chat", { open: n === 0 }]}>{chat}</p>)}
                <p class="line room">
                  <span class="hash">#</span>{sc.room}
                  <span class="faces">
                    <BotArt name={CAST.writer.name} size={20} />
                    <BotArt name={CAST.reviewer.name} size={20} />
                    <BotArt name={CAST.researcher.name} size={20} />
                  </span>
                </p>
              </div>
            </div>
          ) : null}

          {i === 1 ? (
            <div class="scene" role="img" aria-label={`${item.title}. ${illustrated}.`}>
              <ol class="week">
                {sc.days.map((day, n) => (
                  <li class:list={{ today: n === today }}>
                    <span class="day">{day}</span>
                    <span class="slot">
                      <span class="time">08:00</span>
                      <span class="what"><Logo size={16} tile id={`week-${n}`} />{sc.routine}</span>
                      {n === sc.days.length - 1 ? (
                        <>
                          <span class="time later">16:00</span>
                          <span class="what"><BotArt name={CAST.writer.name} size={16} />{sc.routine2}</span>
                        </>
                      ) : null}
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          ) : null}

          {i === 2 ? (
            <div class="scene" role="img" aria-label={`${item.title}. ${illustrated}.`}>
              <div class="board">
                <div class="col">
                  <p class="colhead">{sc.columns[0]}<span class="n">1</span></p>
                  <p class="task"><BotArt name={CAST.reviewer.name} size={20} /><span>{sc.tasks[0]}</span><span class="dot" /></p>
                </div>
                <div class="col">
                  <p class="colhead">{sc.columns[1]}<span class="n needs">1</span></p>
                  <p class="task needs"><BotArt name={CAST.writer.name} size={20} /><span>{sc.tasks[1]}</span></p>
                </div>
                <div class="col">
                  <p class="colhead">{sc.columns[2]}<span class="n">1</span></p>
                  <p class="task done">
                    <Logo size={20} tile id="board-done" /><span>{sc.tasks[2]}</span>
                    <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </p>
                </div>
              </div>
            </div>
          ) : null}

          <div class="body">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
    <ul class="grid text-cards">
      {t.items.slice(3).map((item) => (
        <li>
          <div class="body">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.tags.length > 0 ? (
              <ul class="tags">
                {item.tags.map((tag) => <li><Brand name={tag} size={16} />{tag}</li>)}
              </ul>
            ) : null}
          </div>
        </li>
      ))}
    </ul>
    <p class="note">{illustrated}</p>
  </div>
</section>

<style>
  /* Two rows of equal cards: three scene cards, then six text cards in a 3 x 2 grid. */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .text-cards {
    margin-top: 16px;
  }
  .grid > li {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
  }
  .text-cards > li {
    grid-template-rows: 1fr;
  }
  .body {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 24px;
  }
  .body h3 {
    font-size: 20px;
    line-height: 28px;
    letter-spacing: -0.02em;
  }
  .body p {
    color: var(--muted-foreground);
    font-size: 16px;
    line-height: 24px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding-inline: 8px;
    border-radius: var(--radius-sm);
    background: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }
  .note {
    margin-top: 16px;
    color: var(--muted-foreground);
    font-size: 12px;
    line-height: 16px;
    text-align: right;
  }

  /* Scenes: the top of a lead card, on the sidebar tone, at a fixed height so paired cards line up. */
  .scene {
    display: grid;
    place-items: center;
    height: 224px;
    padding: 24px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--sidebar);
    font-size: 14px;
    line-height: 20px;
  }

  /* Chats and rooms: one bot's chats, one per intention, and a room the team shares. */
  .side {
    display: grid;
    gap: 2px;
    width: min(100%, 320px);
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
  .line {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding-inline: 8px;
    border-radius: var(--radius-md);
  }
  .line.chat {
    padding-left: 40px;
    color: var(--muted-foreground);
  }
  .line.open {
    background: var(--accent);
    color: var(--foreground);
  }
  .line.room {
    height: 40px;
    margin-top: 4px;
    padding-top: 4px;
    border-top: 1px solid var(--border);
    border-radius: 0;
  }
  .hash {
    width: 24px;
    color: var(--muted-foreground);
    text-align: center;
  }
  .faces {
    display: flex;
    margin-left: auto;
  }
  .faces > :global(*) {
    box-sizing: content-box;
    border: 2px solid var(--card);
  }
  .faces > :global(* + *) {
    margin-left: -6px;
  }

  /* Routines and agenda: the same routine every weekday. */
  /* Three days: a third of the page is too narrow for five columns, and names would break mid-word. */
  .week {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
  }
  .week li:nth-child(-n + 2) {
    display: none;
  }
  .week li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: 8px;
    min-width: 0;
  }
  .day {
    color: var(--muted-foreground);
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    text-align: center;
  }
  .today .day {
    color: var(--primary);
  }
  .slot {
    display: grid;
    align-content: start;
    gap: 4px;
    min-height: 104px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
  .today .slot {
    border-color: var(--primary);
  }
  .time.later {
    margin-top: 8px;
  }
  .time {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .what {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    min-width: 0;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
  }

  /* Attention and tasks: the same tasks as kanban columns. */
  .board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
  }
  .col {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .colhead {
    display: block;
    min-height: 32px;
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
  }
  .n {
    display: inline-block;
    margin-left: 6px;
    padding-inline: 6px;
    border-radius: var(--radius-sm);
    background: var(--muted);
    font-size: 12px;
    line-height: 20px;
  }
  .n.needs {
    background: var(--attention);
    color: var(--attention-foreground);
  }
  .task {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    min-height: 72px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    font-size: 12px;
    line-height: 16px;
  }
  .task > span:first-of-type {
    flex: 1;
  }
  .task.needs {
    border-color: var(--attention);
    background: color-mix(in srgb, var(--attention) 12%, var(--card));
  }
  .task.done svg {
    flex: none;
    color: var(--success);
  }
  /* Working: a quiet info dot. The column heading says it in words. */
  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 4px;
    border-radius: 50%;
    background: var(--info);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .lead-cards > li:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .lead-cards > li:last-child {
      grid-column: auto;
    }
    .body {
      padding: 20px;
    }
    .scene {
      height: auto;
      min-height: 200px;
      padding: 16px;
    }
    .slot {
      min-height: 96px;
      padding: 6px;
    }
  }
</style>
