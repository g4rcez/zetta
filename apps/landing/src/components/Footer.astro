---
import { getCopy, type Locale } from "../i18n";
import { DOCS, ISSUES, LICENSE, REPO } from "../links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { footer: t } = getCopy(locale);
const external = { target: "_blank", rel: "noopener noreferrer" };
const languages = [
  { href: "/", label: "English", lang: "en", current: locale === "en" },
  { href: "/pt-br/", label: "Português (Brasil)", lang: "pt-BR", current: locale === "pt-br" },
];
---

<footer class="footer">
  <div class="wrap bar">
    <p class="tagline">{t.tagline}</p>
    <nav aria-label="Zetta">
      <ul>
        <li><a href={REPO} {...external}>{t.links.repo}</a></li>
        <li><a href={DOCS} {...external}>{t.links.docs}</a></li>
        <li><a href={ISSUES} {...external}>{t.links.issues}</a></li>
        <li><a href={LICENSE} {...external}>{t.license}</a></li>
        {languages.map((l) => (
          <li><a href={l.href} lang={l.lang} hreflang={l.lang} aria-current={l.current ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--background);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: 24px;
  }
  .tagline {
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 20px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--foreground);
    font-size: 14px;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  a[aria-current="page"] {
    font-weight: 600;
  }
</style>
