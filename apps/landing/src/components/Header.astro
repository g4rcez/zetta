---
import Logo from "./Logo.astro";
import GithubMark from "./GithubMark.astro";
import { getCopy, type Locale } from "../i18n";
import { REPO } from "../links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { header: t } = getCopy(locale);
const home = locale === "pt-br" ? "/pt-br/" : "/";
const other = locale === "pt-br" ? "en" : "pt-BR";
const links = [
  { href: "#live", label: t.nav.live },
  { href: "#features", label: t.nav.features },
  { href: "#chief", label: t.nav.chief },
  { href: "#faq", label: t.nav.faq },
];
---

<header class="header" data-header>
  <div class="wrap bar">
    <a class="brand" href={home} aria-label={t.home}>
      <Logo size={32} tile id="header" />
      <span>Zetta</span>
    </a>
    <nav class="links" aria-label="Zetta">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="lang" href={t.switchHref} hreflang={other} lang={other} title={t.switchName}>{t.switchLabel}</a>
      <a class="btn btn-ghost btn-sm github" href={REPO} target="_blank" rel="noopener noreferrer"><GithubMark />{t.github}</a>
      <a class="btn btn-primary btn-sm" href="#install">{t.install}</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms,
      border-color 200ms;
  }
  /* Clear at the top of the page; once the page scrolls, a blurred ground and a hairline. */
  .header[data-scrolled] {
    border-bottom-color: var(--border);
    background: color-mix(in srgb, var(--background) 84%, transparent);
    backdrop-filter: saturate(1.4) blur(16px);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
  }
  /* Three columns: the outer two take the same share, so the links stay centered whatever the logo and the actions measure. */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    height: 64px;
  }
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--foreground);
    font-size: 19px;
    font-weight: 640;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .links ul {
    display: flex;
    justify-content: center;
    gap: 28px;
  }
  .links a {
    color: var(--muted-foreground);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--foreground);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-self: end;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding-inline: 10px;
    border-radius: 999px;
    color: var(--foreground);
    font-size: 14px;
    font-weight: 560;
    text-decoration: none;
  }
  .lang:hover {
    background: var(--accent);
  }
  .github {
    color: var(--foreground);
  }
  @media (max-width: 1100px) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    .links,
    .github {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const update = () => {
    if (!header) return;
    if (scrollY > 8) header.setAttribute("data-scrolled", "");
    else header.removeAttribute("data-scrolled");
  };
  addEventListener("scroll", update, { passive: true });
  update();
</script>
