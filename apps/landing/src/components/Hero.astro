---
import HeroShader from "./HeroShader.astro";
import Window from "./Window.astro";
import { getCopy, type Locale } from "../i18n";
import { REPO } from "../links";

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale).hero;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <HeroShader />
  <div class="wrap">
    <h1 id="hero-title">{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <div class="row">
      <a class="btn btn-primary" href="#self-host">{t.primary}</a>
      <a class="btn" href={REPO} target="_blank" rel="noopener noreferrer">{t.secondary}</a>
    </div>
    <p class="note">{t.note}</p>
    <div class="shot">
      <Window title="Zetta" label={t.screenAlt}>
        <img src="/screens/hero.webp" width="1800" height="715" alt={t.screenAlt} fetchpriority="high" decoding="async" />
      </Window>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 80px 96px;
  }
  .wrap {
    position: relative;
    z-index: 1;
  }
  h1 {
    max-width: 12em;
    font-size: clamp(40px, 6vw, 80px);
  }
  .lead {
    max-width: 52ch;
    margin-block: 24px 32px;
    font-size: 20px;
    line-height: 30px;
  }
  .note {
    margin-top: 16px;
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 20px;
  }
  .shot {
    margin-top: 64px;
  }
  @media (max-width: 720px) {
    .hero {
      padding-block: 48px 64px;
    }
    .lead {
      font-size: 18px;
      line-height: 28px;
    }
    .shot {
      margin-top: 40px;
    }
  }
</style>
