---
import HeroShader from "./HeroShader.astro";
import RobotHero from "./RobotHero.astro";
import { getCopy, type Locale } from "../i18n";
import { INSTALL } from "../links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale).hero;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <HeroShader />
  <div class="wrap grid">
    <div class="text">
      <h1 id="hero-title" class="rv">
        {t.title.before}<span class="mark">{t.title.mark}</span>{t.title.after}{" "}<span class="rest">{t.title.rest}</span>
      </h1>
      <p class="lead rv">{t.lead}</p>
      <div class="install rv">
        <p class="install-label">{t.installLabel}</p>
        <div class="code">
          <pre><code>curl -fsSL {INSTALL} | bash</code></pre>
          <button class="btn btn-sm" type="button" data-copy data-copied={t.copied} data-label={t.copy}>{t.copy}</button>
        </div>
      </div>
      <div class="row rv">
        <a class="btn btn-primary" href="#install">{t.primary}</a>
        <a class="btn" href="#live">{t.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <ul class="proof rv">
        {t.proof.map((item) => <li>{item}</li>)}
      </ul>
      <p class="note rv">{t.note}</p>
    </div>
    <RobotHero locale={locale} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 48px 112px;
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: center;
  }
  .text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
  }
  h1 {
    max-width: 14em;
    font-size: clamp(40px, 5.3vw, 78px);
    line-height: 1.04;
  }
  /* The promise and who keeps it sit on two lines, so a line never ends halfway through a sentence. */
  .rest {
    display: block;
  }
  /* The key word: bolder, in the main color (the same as the emphasis of every other heading). */
  .mark {
    color: var(--primary);
    font-weight: 800;
  }
  .lead {
    max-width: 48ch;
    margin-block: 24px 28px;
    font-size: 19px;
    line-height: 29px;
  }
  .install {
    width: 100%;
    max-width: 560px;
    margin-bottom: 24px;
  }
  .install-label {
    margin-bottom: 8px;
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 20px;
  }
  .code {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 18px;
    border-radius: 14px;
    background: var(--ink);
    color: var(--on-ink);
    box-shadow: 0 24px 48px -28px rgb(20 24 29 / 0.6);
  }
  .code pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    white-space: pre;
  }
  .code .btn {
    border-color: transparent;
    background: #2a313a;
    color: #fff;
  }
  .code .btn:hover {
    background: #3a434e;
  }
  /* Four facts in one line, each one in the copy of the page: the strip that proves the promise above it. */
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 28px;
    color: var(--foreground);
    font-size: 14px;
    font-weight: 560;
    line-height: 20px;
  }
  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .proof li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand);
  }
  .note {
    margin-top: 16px;
    max-width: 52ch;
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 20px;
  }
  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 72px;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-block: 40px 72px;
    }
    .lead {
      font-size: 18px;
      line-height: 28px;
    }
  }
</style>
