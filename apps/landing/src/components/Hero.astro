---
import HeroShader from "./HeroShader.astro";
import Window from "./Window.astro";
import { getCopy, type Locale } from "../i18n";
import { INSTALL, REPO } from "../links";

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale).hero;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <HeroShader />
  <div class="wrap">
    <h1 id="hero-title">{t.title}</h1>
    <p class="lead">{t.lead}</p>
    <div class="install">
      <p class="install-label">{t.installLabel}</p>
      <div class="code">
        <pre><code>curl -fsSL {INSTALL} | bash</code></pre>
        <button class="btn btn-sm" type="button" data-copy data-copied={t.copied} data-label={t.copy}>{t.copy}</button>
      </div>
    </div>
    <div class="row">
      <a class="btn btn-primary" href="#self-host">{t.primary}</a>
      <a class="btn" href={REPO} target="_blank" rel="noopener noreferrer">{t.secondary}</a>
    </div>
    <p class="note">{t.note}</p>
    <div class="shot">
      <Window title="Zetta" label={t.screenAlt}>
        <img src="/screens/hero.webp" width="1800" height="715" alt={t.screenAlt} fetchpriority="high" decoding="async" />
      </Window>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 80px 96px;
  }
  .wrap {
    position: relative;
    z-index: 1;
  }
  h1 {
    max-width: 12em;
    font-size: clamp(40px, 6vw, 80px);
  }
  .lead {
    max-width: 52ch;
    margin-block: 24px 32px;
    font-size: 20px;
    line-height: 30px;
  }
  .install {
    max-width: 560px;
    margin-bottom: 24px;
  }
  .install-label {
    margin-bottom: 8px;
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 20px;
  }
  .code {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
  }
  .code pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    white-space: pre;
  }
  .note {
    margin-top: 16px;
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 20px;
  }
  .shot {
    margin-top: 64px;
  }
  @media (max-width: 720px) {
    .hero {
      padding-block: 48px 64px;
    }
    .lead {
      font-size: 18px;
      line-height: 28px;
    }
    .shot {
      margin-top: 40px;
    }
  }
</style>
