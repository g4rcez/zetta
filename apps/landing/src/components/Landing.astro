---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Product from "./Product.astro";
import Network from "./Network.astro";
import SelfHost from "./SelfHost.astro";
import Footer from "./Footer.astro";
import { getCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta } = getCopy(locale);
---

<Layout lang={locale} title={meta.title} description={meta.description}>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <Product locale={locale} />
    <Network locale={locale} />
    <SelfHost locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
