---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Strip from "./Strip.astro";
import UseCases from "./UseCases.astro";
import HowItWorks from "./HowItWorks.astro";
import Control from "./Control.astro";
import Features from "./Features.astro";
import Teams from "./Teams.astro";
import SelfHost from "./SelfHost.astro";
import Faq from "./Faq.astro";
import Cta from "./Cta.astro";
import Footer from "./Footer.astro";
import { getCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { meta } = getCopy(locale);
---

<Layout lang={locale} title={meta.title} description={meta.description}>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <Strip locale={locale} />
    <UseCases locale={locale} />
    <HowItWorks locale={locale} />
    <Control locale={locale} />
    <Features locale={locale} />
    <Teams locale={locale} />
    <SelfHost locale={locale} />
    <Faq locale={locale} />
    <Cta locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
