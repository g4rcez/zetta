---
// The product shown as it is: real light-mode screenshots (public/screens), taken on a throwaway install with demo data.
import Window from "./Window.astro";
import { getCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale).product;
const windowTitle = { inbox: "Zetta · Inbox", chat: "Zetta · Writer", tasks: "Zetta · Tasks", routines: "Zetta · Routines" } as const;
const size = { inbox: [1800, 904], chat: [1800, 794], tasks: [1800, 794], routines: [1800, 904] } as const;
---

<section class="section band" id="product" aria-labelledby="product-title">
  <div class="wrap">
    <h2 id="product-title">{t.title}</h2>
    <div class="rows">
      {t.rows.map((row, i) => (
        <article class="row-item">
          <div class="text">
            <h3>{row.title}</h3>
            <p>{row.body}</p>
          </div>
          <Window title={windowTitle[row.id]} label={row.alt}>
            <img src={`/screens/${row.id}.webp`} width="1800" height={size[row.id][1]} alt={row.alt} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
          </Window>
        </article>
      ))}
    </div>
    <p class="caption">{t.note}</p>
  </div>
</section>

<style>
  h2 {
    max-width: 16em;
    margin-bottom: 72px;
  }
  .rows {
    display: grid;
    gap: 96px;
  }
  .row-item {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px;
    align-items: center;
  }
  .row-item:nth-child(even) {
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
  }
  .row-item:nth-child(even) .text {
    order: 2;
  }
  h3 {
    font-size: 28px;
    line-height: 36px;
    letter-spacing: -0.03em;
  }
  .text p {
    margin-top: 16px;
    color: var(--muted-foreground);
    font-size: 17px;
    line-height: 26px;
  }
  .caption {
    margin-top: 64px;
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 20px;
  }
  @media (max-width: 900px) {
    h2 {
      margin-bottom: 48px;
    }
    .rows {
      gap: 64px;
    }
    .row-item,
    .row-item:nth-child(even) {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .row-item:nth-child(even) .text {
      order: 0;
    }
  }
</style>
