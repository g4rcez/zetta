---
import { getCopy, type Locale } from "../i18n";
import { DOCS, INSTALL, REPO } from "../links";

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale).install;

// The by-hand commands come from docker-compose.yml, apps/server/.env.schema, apps/web/.env.schema and the docker:up script in package.json.
// The secrets are made with `openssl rand -base64 32`, as the schema comments say. DATABASE_URL and CORS_ORIGIN are set by docker-compose.yml.
// The one-line installer (install.sh) does the same steps; it needs git, openssl and a running docker or podman, on macOS, Linux or WSL.
const manual = [
  `git clone ${REPO}.git\ncd zetta`,
  [
    "cat > apps/server/.env <<EOF",
    "BETTER_AUTH_SECRET=$(openssl rand -base64 32)",
    "BETTER_AUTH_URL=http://localhost:3000",
    "ZETTA_CONNECTION_KEY=$(openssl rand -base64 32)",
    "ZETTA_SETUP_KEY=$(openssl rand -base64 32)",
    "EOF",
    'echo "VITE_SERVER_URL=http://localhost:3000" > apps/web/.env',
  ].join("\n"),
  "docker compose up -d --build",
];
---

<section class="section install" id="install" aria-labelledby="install-title">
  <div class="wrap layout">
    <div class="side rv">
      <div class="sec-head">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="install-title">{t.title.before}<em>{t.title.mark}</em>{t.title.after}</h2>
        <p class="lead">{t.lead}</p>
      </div>
      <ul class="badges">
        {t.badges.map((b) => <li>{b}</li>)}
      </ul>
      <p class="note">{t.note}</p>
    </div>

    <div class="main">
      <ol class="steps">
        {
          t.steps.map((step, i) => (
            <li class="rv">
              <span class="n tabular" aria-hidden="true">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {i === 0 ? (
                <div class="code">
                  <pre><code>curl -fsSL {INSTALL} | bash</code></pre>
                  <button class="btn btn-sm" type="button" data-copy data-copied={t.copied} data-label={t.copy}>{t.copy}</button>
                </div>
              ) : null}
            </li>
          ))
        }
      </ol>

      <details class="manual rv">
        <summary>{t.manual.summary}</summary>
        <p>{t.manual.body}</p>
        {
          manual.map((cmd) => (
            <div class="code">
              <pre><code>{cmd}</code></pre>
              <button class="btn btn-sm" type="button" data-copy data-copied={t.copied} data-label={t.copy}>{t.copy}</button>
            </div>
          ))
        }
        <a href={DOCS} target="_blank" rel="noopener noreferrer">{t.manual.docs}</a>
      </details>
    </div>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px 88px;
    align-items: start;
  }
  .side {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 28px;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .badges li {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding-inline: 14px;
    border-radius: 999px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 14px;
    font-weight: 600;
  }
  .note {
    max-width: 44ch;
    color: var(--muted-foreground);
    font-size: 15px;
    line-height: 22px;
  }
  .steps {
    display: grid;
  }
  .steps > li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 20px;
    row-gap: 4px;
    padding-block: 32px;
    border-top: 1px solid var(--border);
  }
  .steps > li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .n {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--primary-foreground);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }
  .steps h3 {
    font-size: 22px;
    line-height: 32px;
    letter-spacing: -0.025em;
  }
  .steps p {
    color: var(--muted-foreground);
    font-size: 16px;
    line-height: 24px;
  }
  .code {
    position: relative;
    grid-column: 2;
    margin-top: 14px;
    border-radius: 14px;
    background: var(--ink);
    color: var(--on-ink);
  }
  .code pre {
    overflow-x: auto;
    padding: 16px 88px 16px 18px;
  }
  .code button {
    position: absolute;
    top: 8px;
    right: 8px;
    border-color: transparent;
    background: #2a313a;
    color: #fff;
  }
  .code button:hover {
    background: #3a434e;
  }
  .manual {
    margin-top: 16px;
    padding: 20px 24px;
    border-radius: var(--radius-2xl);
    background: var(--sidebar);
  }
  .manual summary {
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
  }
  .manual p {
    margin-block: 12px 4px;
    color: var(--muted-foreground);
    font-size: 15px;
    line-height: 22px;
  }
  .manual .code {
    margin-top: 12px;
  }
  .manual a {
    display: inline-block;
    margin-top: 16px;
    font-size: 15px;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      position: static;
    }
  }
  /* Narrow: the Copy button leaves the code and sits above it, so it never covers a command. */
  @media (max-width: 640px) {
    .code {
      display: grid;
    }
    .code button {
      position: static;
      justify-self: end;
      margin: 8px 8px 0;
    }
    .code pre {
      padding: 8px 16px 16px;
    }
    .steps > li {
      grid-template-columns: 32px minmax(0, 1fr);
      column-gap: 14px;
    }
    .n {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const code = button.parentElement?.querySelector("code")?.textContent ?? "";
      const status = document.querySelector("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        return; // Clipboard blocked (for example on plain http): the text stays selectable.
      }
      const label = button.dataset.label ?? "";
      button.textContent = button.dataset.copied ?? "";
      if (status) status.textContent = button.dataset.copied ?? "";
      setTimeout(() => {
        button.textContent = label;
        if (status) status.textContent = "";
      }, 2000);
    });
  });
</script>
