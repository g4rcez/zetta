---
import GithubMark from "./GithubMark.astro";
import { getCopy, type Locale } from "../i18n";
import { DOCS, ISSUES, REPO } from "../links";

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale).selfHost;

// Commands come from docker-compose.yml, apps/server/.env.schema, apps/web/.env.schema and the docker:up script in package.json.
// The secrets are made with `openssl rand -base64 32`, as the schema comments say. DATABASE_URL and CORS_ORIGIN are set by docker-compose.yml.
const commands = [
  `git clone ${REPO}.git\ncd zetta`,
  [
    "cat > apps/server/.env <<EOF",
    "BETTER_AUTH_SECRET=$(openssl rand -base64 32)",
    "BETTER_AUTH_URL=http://localhost:3000",
    "ZETTA_CONNECTION_KEY=$(openssl rand -base64 32)",
    "ZETTA_SETUP_KEY=$(openssl rand -base64 32)",
    "EOF",
    'echo "VITE_SERVER_URL=http://localhost:3000" > apps/web/.env',
  ].join("\n"),
  "docker compose up -d --build",
  null,
];
---

<section class="section band" id="self-host" aria-labelledby="self-host-title">
  <div class="wrap">
    <div class="layout">
      <div class="side">
        <div class="sec-head">
          <h2 id="self-host-title">{t.title}</h2>
          <p class="lead">{t.lead}</p>
        </div>
        <p class="note">{t.note}</p>
        <a class="docs" href={DOCS} target="_blank" rel="noopener noreferrer">{t.docs}</a>
      </div>

      <ol class="steps">
        {t.steps.map((step, i) => (
          <li>
            <span class="n tabular" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            {commands[i] ? (
              <div class="code">
                <button class="btn btn-sm" type="button" data-copy data-copied={t.copied} data-label={t.copy}>{t.copy}</button>
                <pre><code>{commands[i]}</code></pre>
              </div>
            ) : null}
          </li>
        ))}
      </ol>
    </div>

    <div class="close">
      <div>
        <h3>{t.last.title}</h3>
        <p>{t.last.body}</p>
      </div>
      <div class="row">
        <a class="btn btn-primary" href={REPO} target="_blank" rel="noopener noreferrer"><GithubMark />{t.last.primary}</a>
        <a class="btn" href={ISSUES} target="_blank" rel="noopener noreferrer">{t.last.secondary}</a>
      </div>
    </div>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px 80px;
    align-items: start;
  }
  .side {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 24px;
  }
  .note {
    max-width: 44ch;
    color: var(--muted-foreground);
    font-size: 15px;
    line-height: 22px;
  }
  .docs {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    justify-self: start;
    font-size: 15px;
  }
  .steps {
    display: grid;
  }
  .steps > li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 4px;
    padding-block: 28px;
    border-top: 1px solid var(--input);
  }
  .steps > li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .n {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--input);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .steps h3 {
    font-size: 18px;
    line-height: 28px;
  }
  .steps p {
    color: var(--muted-foreground);
    font-size: 16px;
    line-height: 24px;
  }
  .code {
    position: relative;
    grid-column: 2;
    margin-top: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
  .code pre {
    overflow-x: auto;
    padding: 16px 88px 16px 16px;
  }
  .code button {
    position: absolute;
    top: 8px;
    right: 8px;
  }
  .close {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid var(--input);
  }
  .close h3 {
    font-size: 28px;
    line-height: 36px;
    letter-spacing: -0.03em;
  }
  .close p {
    max-width: 52ch;
    margin-top: 8px;
    color: var(--muted-foreground);
    font-size: 17px;
    line-height: 26px;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .side {
      position: static;
    }
  }
  /* Narrow: the Copy button leaves the code and sits above it, so it never covers a command. */
  @media (max-width: 640px) {
    .code {
      display: grid;
    }
    .code button {
      position: static;
      justify-self: end;
      margin: 8px 8px 0;
    }
    .code pre {
      padding: 8px 16px 16px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const code = button.parentElement?.querySelector("code")?.textContent ?? "";
      const status = document.querySelector("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        return; // Clipboard blocked (for example on plain http): the text stays selectable.
      }
      button.textContent = button.dataset.copied ?? "";
      if (status) status.textContent = button.dataset.copied ?? "";
      setTimeout(() => {
        button.textContent = button.dataset.label ?? "";
        if (status) status.textContent = "";
      }, 2000);
    });
  });
</script>
