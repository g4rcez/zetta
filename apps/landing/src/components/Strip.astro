---
// Integrations from the app's plugin catalog, each with the vendor mark the app itself shows (see src/cast.ts).
// The track scrolls slowly. The Pause button stops it (WCAG 2.2.2). With reduced motion it does not move and wraps.
import Brand from "./Brand.astro";
import { getCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale).strip;
const names = ["GitHub", "Linear", "Notion", "Sentry", "PostHog", "Cloudflare", "Google Calendar", "Gmail", "Google Drive", "Telegram", "WhatsApp", "Playwright", "PostgreSQL", "1Password", "Bitwarden", "Context7", "Chrome DevTools"];
---

<section class="strip band" aria-labelledby="strip-title">
  <div class="wrap top">
    <h2 id="strip-title">{t.title}</h2>
    <button type="button" class="toggle" data-strip-toggle data-pause={t.pause} data-play={t.play}>{t.pause}</button>
  </div>
  <div class="viewport" role="group" aria-label={t.label}>
    <div class="track" data-strip>
      <ul>{names.map((n) => <li><Brand name={n} size={24} />{n}</li>)}</ul>
      <ul aria-hidden="true">{names.map((n) => <li><Brand name={n} size={24} />{n}</li>)}</ul>
    </div>
  </div>
</section>

<style>
  .strip {
    padding-block: 56px 64px;
    border-block: 1px solid var(--border);
    overflow: hidden;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 32px;
  }
  h2 {
    font-size: 20px;
    line-height: 28px;
    letter-spacing: -0.02em;
    text-align: center;
  }
  .toggle {
    flex: none;
    height: 28px;
    padding-inline: 12px;
    border: 1px solid var(--input);
    border-radius: var(--radius-md);
    background: var(--card);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .toggle:hover {
    background: var(--accent);
  }
  .viewport {
    overflow: hidden;
    mask: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 64s linear infinite;
  }
  .track[data-paused] {
    animation-play-state: paused;
  }
  ul {
    display: flex;
    flex: none;
    gap: 12px;
    padding-right: 12px;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding-inline: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    font-size: 16px;
    font-weight: 500;
    white-space: nowrap;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle,
    ul[aria-hidden] {
      display: none;
    }
    .viewport {
      mask: none;
    }
    .track {
      width: 100%;
      justify-content: center;
      animation: none;
    }
    ul {
      flex: 0 1 auto;
      max-width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      padding-inline: var(--gutter);
    }
  }
  @media (max-width: 720px) {
    .top {
      flex-direction: column;
      gap: 12px;
    }
  }
  /* With reduced motion: wrapped rows on wide screens, one row to swipe on narrow ones. */
  @media (prefers-reduced-motion: reduce) and (max-width: 720px) {
    .viewport {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .track {
      justify-content: flex-start;
    }
    ul {
      flex: none;
      flex-wrap: nowrap;
      max-width: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-strip-toggle]");
  const track = document.querySelector<HTMLElement>("[data-strip]");
  toggle?.addEventListener("click", () => {
    const paused = track?.toggleAttribute("data-paused") ?? false;
    toggle.textContent = (paused ? toggle.dataset.play : toggle.dataset.pause) ?? "";
  });
</script>
