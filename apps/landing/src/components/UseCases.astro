---
// The rotating showcase: three example runs as tabs, the chat on the right. Illustrated, not live.
import Logo from "./Logo.astro";
import BotArt from "./BotArt.astro";
import { CAST } from "../cast";
import { getCopy, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const copy = getCopy(Astro.props.locale);
const d = copy.how.demo;
// Which specialist does the work in each example (the chief's reply names it).
const worker: Record<string, string> = { briefing: CAST.reviewer.name, review: CAST.reviewer.name, newsletter: CAST.writer.name };
---

<section class="section" id="examples" aria-labelledby="examples-title">
  <div class="wrap">
    <div class="head">
      <h2 id="examples-title">{d.title}</h2>
      <p class="lead">{d.lead}</p>
    </div>

    <div class="demo" data-demo>
      <div class="tabs" role="tablist" aria-label={d.tabsLabel}>
        {d.tabs.map((tab, i) => (
          <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1}>
            {tab.label}
          </button>
        ))}
      </div>

      <div class="panels">
        {d.tabs.map((tab, i) => (
          <div class="panel" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} data-panel data-active={i === 0 ? "" : undefined}>
            <div class="copy">
              <div class="crew" aria-hidden="true">
                <Logo size={64} tile id={`crew-${tab.id}`} />
                <BotArt name={worker[tab.id]} size={64} />
              </div>
              <h3>{tab.label}</h3>
              <p class="lead">{tab.pitch}</p>
              <a class="btn btn-primary" href="#self-host">{copy.hero.primary}</a>
            </div>

            <div class="chat">
              <div class="msg" data-reveal>
                <i class="you">{d.you[0]}</i>
                <div><b>{d.you}</b><p>{tab.user}</p></div>
              </div>
              <div class="steps" data-reveal>
                <p class="working"><BotArt name={worker[tab.id]} size={20} /><b>{worker[tab.id]}</b>{d.working}</p>
                <ul>
                  {tab.steps.map((s) => (
                    <li data-reveal>
                      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="msg" data-reveal>
                <Logo size={32} tile id={`demo-${tab.id}`} />
                <div><b>Zetta</b><p>{tab.chief}</p></div>
              </div>
              <div class={`outcome ${tab.outcome.kind}`} data-reveal>
                <h4>
                  {tab.outcome.kind === "done" ? (
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  ) : (
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 2.5v6M8 12v1.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
                  )}
                  {tab.outcome.title}
                </h4>
                <p>{tab.outcome.body}</p>
                {"actions" in tab.outcome && tab.outcome.actions ? (
                  <div class="acts"><span class="ok">{tab.outcome.actions[0]}</span><span class="no">{tab.outcome.actions[1]}</span></div>
                ) : null}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="foot">
        <span>{d.illustrated}</span>
        <div class="buttons">
          <button type="button" data-pause data-label-pause={d.pause} data-label-resume={d.resume}>{d.pause}</button>
          <button type="button" data-replay>{d.replay}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .demo {
    max-width: 1040px;
    margin-inline: auto;
  }
  .tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .tabs button {
    height: 44px;
    padding-inline: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: transparent;
    color: var(--muted-foreground);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }
  .tabs button:hover {
    background: var(--accent);
    color: var(--foreground);
  }
  .tabs button[aria-selected="true"] {
    border-color: var(--primary);
    background: var(--card);
    color: var(--foreground);
  }

  /* All panels share one grid cell, so the box keeps the height of the tallest one. */
  .panels {
    display: grid;
    padding: 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    background: var(--sidebar);
  }
  .panel {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px;
    align-items: center;
  }
  .panel:not([data-active]) {
    visibility: hidden;
  }
  .copy {
    display: grid;
    justify-items: start;
    gap: 20px;
  }
  .crew {
    display: flex;
    margin-bottom: 4px;
  }
  .crew > :global(*) {
    border: 3px solid var(--sidebar);
    border-radius: 22%;
  }
  .crew > :global(* + *) {
    margin-left: -12px;
    transform: rotate(6deg);
  }
  .copy h3 {
    font-size: 32px;
    line-height: 36px;
    letter-spacing: -0.03em;
  }

  .chat {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    font-size: 14px;
    line-height: 20px;
  }
  .msg {
    display: flex;
    gap: 12px;
  }
  .msg b {
    font-weight: 500;
  }
  .msg i {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    font-style: normal;
    font-weight: 600;
  }
  .steps {
    margin-left: 44px;
  }
  .working {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted-foreground);
  }
  .working b {
    color: var(--foreground);
    font-weight: 500;
  }
  .steps ul {
    margin-top: 4px;
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
    color: var(--muted-foreground);
  }
  .steps svg {
    flex: none;
    color: var(--success);
  }
  .outcome {
    margin-left: 44px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .outcome h4 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
  }
  .outcome p {
    margin-top: 4px;
  }
  .outcome.done h4 {
    color: var(--success);
  }
  .outcome.needs {
    border-color: color-mix(in srgb, var(--attention) 60%, transparent);
    background: color-mix(in srgb, var(--attention) 12%, var(--card));
  }
  .outcome.needs h4 {
    color: var(--warn);
  }
  .acts {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .acts span {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding-inline: 12px;
    border-radius: var(--radius-md);
    font-weight: 500;
  }
  .ok {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .no {
    border: 1px solid var(--input);
    background: var(--card);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 12px;
    color: var(--muted-foreground);
    font-size: 12px;
    line-height: 16px;
  }
  .buttons {
    display: flex;
    gap: 4px;
  }
  .buttons button {
    height: 28px;
    padding-inline: 12px;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .buttons button:hover {
    background: var(--accent);
  }

  /* The script adds .js when the first run starts. Before that, and without script, every step is visible. */
  :global(.js) [data-reveal] {
    opacity: 0;
    transform: translateY(4px);
  }
  :global(.js) [data-reveal].on {
    opacity: 1;
    transform: none;
    transition:
      opacity 200ms,
      transform 200ms;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-pause] {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .panels {
      padding: 20px;
    }
    .panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      align-items: start;
    }
    .copy h3 {
      font-size: 28px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-demo]");

  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const pauseButton = root.querySelector<HTMLButtonElement>("[data-pause]");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const STEP_MS = 650;
    const HOLD_MS = 4500;

    let current = 0;
    let timers: number[] = [];
    let advanceTimer = 0;
    let auto = !reduce; // The Pause button and any tab click stop the rotation. It never runs with reduced motion.
    let hovering = false;
    let visible = false;

    const syncPause = () => {
      if (pauseButton) pauseButton.textContent = (auto ? pauseButton.dataset.labelPause : pauseButton.dataset.labelResume) ?? "";
    };

    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const wait = (ms: number, fn: () => void) => {
      timers.push(window.setTimeout(fn, ms));
    };

    const schedule = (ms: number) => {
      clearTimeout(advanceTimer);
      advanceTimer = window.setTimeout(advance, ms);
    };

    function advance() {
      if (!auto) return;
      if (hovering || !visible) return schedule(1000);
      select((current + 1) % tabs.length);
    }

    const play = () => {
      // The reveal hides items only once a run starts, so the page is complete without script, in a full-page capture, and if the observer never fires.
      document.documentElement.classList.add("js");
      clear();
      const items = [...panels[current].querySelectorAll<HTMLElement>("[data-reveal]")];
      items.forEach((el) => el.classList.remove("on"));
      items.forEach((el, n) => wait(reduce ? 0 : 350 + n * STEP_MS, () => el.classList.add("on")));
      if (auto) schedule(350 + items.length * STEP_MS + HOLD_MS);
      else clearTimeout(advanceTimer);
    };

    function select(index: number) {
      current = index;
      tabs.forEach((tab, n) => {
        tab.setAttribute("aria-selected", String(n === index));
        tab.tabIndex = n === index ? 0 : -1;
      });
      panels.forEach((panel, n) => (n === index ? panel.setAttribute("data-active", "") : panel.removeAttribute("data-active")));
      play();
    }

    const byUser = (index: number) => {
      auto = false;
      syncPause();
      select(index);
    };

    tabs.forEach((tab, n) => {
      tab.addEventListener("click", () => byUser(n));
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowRight" ? (n === last ? 0 : n + 1)
          : event.key === "ArrowLeft" ? (n === 0 ? last : n - 1)
          : event.key === "Home" ? 0
          : event.key === "End" ? last
          : -1;
        if (next < 0) return;
        event.preventDefault();
        byUser(next);
        tabs[next].focus();
      });
    });

    root.querySelector("[data-replay]")?.addEventListener("click", () => {
      auto = false;
      syncPause();
      play();
    });

    pauseButton?.addEventListener("click", () => {
      auto = !auto;
      syncPause();
      if (auto) schedule(HOLD_MS);
      else clearTimeout(advanceTimer);
    });

    root.addEventListener("pointerenter", () => (hovering = true));
    root.addEventListener("pointerleave", () => (hovering = false));
    root.addEventListener("focusin", () => (hovering = true));
    root.addEventListener("focusout", () => (hovering = false));

    // Start the first run when the demo scrolls into view.
    new IntersectionObserver(
      ([entry]) => {
        const wasVisible = visible;
        visible = entry.isIntersecting;
        if (visible && !wasVisible && timers.length === 0) play();
      },
      { threshold: 0.15 },
    ).observe(root);
  }
</script>
