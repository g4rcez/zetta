# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @required=false
ZETTA_CONNECTION_KEY=

# @public @required=false
ZETTA_ALLOW_PRIVATE_NETWORK=

# Per-user Linux desktops ("VMs"): `docker` runs docker/desktop (cua-spacesd) per VM; `cua` uses the older Cua Spaces CLI.
# @public @required=false
ZETTA_DESKTOP_RUNTIME=

# Desktop VM image and limits (defaults: zetta-desktop:latest, 2g, 2 cpus; 4 VMs and 2 running per user, 6 running in total).
# ZETTA_VM_RUNTIME=runsc uses gVisor; ZETTA_VM_NETWORK attaches VMs to a network with host-level egress rules.
# @public @required=false
ZETTA_VM_IMAGE=
# Container CLI for VMs (default docker); e.g. /opt/podman/bin/podman.
# @public @required=false
ZETTA_DOCKER_BIN=
# @public @required=false
ZETTA_VM_MEMORY=
# @public @required=false
ZETTA_VM_CPUS=
# @public @required=false
ZETTA_VM_RUNTIME=
# @public @required=false
ZETTA_VM_NETWORK=
# @public @required=false
ZETTA_VM_MAX_PER_USER=
# @public @required=false
ZETTA_VM_MAX_RUNNING_PER_USER=
# @public @required=false
ZETTA_VM_MAX_RUNNING=

# Code access for bots: where each user's persistent code workspace lives (default ~/.zetta/code), the per-turn time limit for code runs
# (default 600000 ms), and `off` to disable code access for every bot. Docker harness runs mount the workspace at /work.
# @public @required=false
ZETTA_CODE_ROOT=
# @public @required=false
ZETTA_CODE_TIMEOUT_MS=
# @public @required=false
ZETTA_CODE_ACCESS=
