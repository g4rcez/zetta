# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# The mode the server runs in: development, production or test. The Docker image sets production; leave it alone on a normal install.
# @public @type=enum(development, production, test)
NODE_ENV=development

# The secret the sign-in system signs sessions with: at least 32 random characters (`openssl rand -base64 32`). Keep it private. Changing it
# signs everyone out.
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The one public address of Zetta, scheme and host (and port) with no path: the web app and the API answer on it, the browser calls /api on it,
# and it is the origin Better Auth, CORS, OAuth callbacks and MCP use. Set the same value in apps/web/.env. MCP clients sign in with OAuth,
# which needs HTTPS off loopback: use the public https:// address, whoever terminates TLS.
# @public @type=url
ZETTA_SERVER_URL=

# Postgres connection string. Leave it empty to use the Postgres that ships inside Zetta: it is unpacked into ZETTA_HOME, started with the
# server and migrated at boot. Set it to use your own Postgres 18 with the vector and unaccent extensions.
# @required=false
DATABASE_URL=

# Folder for Zetta's local state, including the embedded database (default ~/.zetta).
# @public @required=false
ZETTA_HOME=

# Encryption key for stored secrets and proof of ownership at first-run onboarding: base64 of 32 random bytes (`openssl rand -base64 32`).
# @type=string(minLength=44, maxLength=44)
ZETTA_CONNECTION_KEY=

# One-time key typed in the browser at first-run onboarding. Use a value different from ZETTA_CONNECTION_KEY (`openssl rand -base64 32`):
# the connection key then never leaves the server. When unset, onboarding asks for ZETTA_CONNECTION_KEY.
# @required=false
ZETTA_SETUP_KEY=

# Session cookie SameSite: none (default, the desktop app needs it), lax or strict. A web-only install should use lax.
# @required=false
ZETTA_COOKIE_SAMESITE=

# Header your reverse proxy sets with the real client address (for example x-forwarded-for or cf-connecting-ip); sign-in rate limits count
# per that address. Unset: the socket address is used. Only set it when the proxy always overwrites or appends the header.
# @required=false
ZETTA_TRUSTED_IP_HEADER=

# Extra origins allowed to sign in and call the API, comma-separated, https only. Every address of this machine (localhost, LAN, Tailscale) and
# ZETTA_SERVER_URL are trusted already: use this only for a host name (a MagicDNS name, a reverse proxy) that is not an interface address.
# Each one is added to Better Auth's trusted origins and to CORS. Restart the server after changing it.
# @public @required=false
ZETTA_EXTRA_ORIGINS=

# Listen address override. Default: 127.0.0.1, or 0.0.0.0 once onboarding opened Zetta to the network. Containers set 0.0.0.0.
# @public @required=false
ZETTA_HOST=

# HTTPS served by the API itself: PEM certificate and private key paths (relative to apps/server). Set both or neither. Leave unset in local
# development: the web dev server is the HTTPS entry point and forwards /api to the API over plain HTTP (PORT=6000). MCP clients sign in with
# OAuth, which needs HTTPS off loopback: ZETTA_SERVER_URL must be the public https:// address, whoever terminates TLS.
# @public @required=false
ZETTA_TLS_CERT=
# @public @required=false
ZETTA_TLS_KEY=
# Extra root certificate Bun trusts, for a local CA such as mkcert's (`bun run certs` copies it to .certs/rootCA.pem), when the server calls an
# HTTPS service signed by it. Bun reads it only at process start: `bun dev` passes it from here, other launchers must export it.
# @public @required=false
NODE_EXTRA_CA_CERTS=

# WhatsApp (WAHA) server that users pair with a QR code. Default URL: http://127.0.0.1:3010. Key: the container's WAHA_API_KEY.
# @public @required=false
ZETTA_WAHA_URL=
# @required=false
ZETTA_WAHA_API_KEY=

# Speech to text (modules/transcribe). The provider, model and language are chosen in Studio > Decisions. Key: an administrator saves it there
# (sealed, stored encrypted); this variable is the operator's own, used only when no key was saved. ZETTA_TRANSCRIBE=off turns speech to text off.
# @required=false
ZETTA_TRANSCRIBE_API_KEY=

# Speech out (text to speech): the provider, model and voice are chosen in Studio. Key: an administrator saves it there (sealed, stored
# encrypted); this variable is the operator's own, used only when no key was saved. The `browser` provider needs no key.
# @required=false
ZETTA_SPEECH_API_KEY=


# Max connections in the app's Postgres pool (default 20). Keep the sum over all server instances below Postgres's max_connections.
# @public @required=false
ZETTA_DB_POOL_MAX=

# Set to 1 to let the server call addresses on this computer or on your network: a speech server, a WhatsApp (WAHA) server or an update feed
# on the LAN. Off by default, because anyone who can enter an address in a plugin could otherwise point the server at your network.
# @public @required=false
ZETTA_ALLOW_PRIVATE_NETWORK=

# Which version this server is: the commit it was built from and that commit's date (ISO 8601). install.sh stamps them into the image; a source
# checkout leaves them empty and the server asks git. Studio shows them, and the update check compares the date with the published changelog.
# @public @required=false
ZETTA_BUILD_COMMIT=
# @public @required=false
ZETTA_BUILD_DATE=
# The daily "newer version" check (docs/operations/upgrade.md). ZETTA_UPDATE_CHECK=off turns it off for the whole server and wins over the
# setting in Studio > Decisions. ZETTA_UPDATE_FEED replaces the changelog address (https; a private network needs ZETTA_ALLOW_PRIVATE_NETWORK=1).
# @public @required=false
ZETTA_UPDATE_CHECK=
# @public @required=false
ZETTA_UPDATE_FEED=

# Per-user Linux desktops ("VMs"): `docker` runs docker/desktop per VM.
# @public @required=false
ZETTA_DESKTOP_RUNTIME=

# Drivers a person may pick for a desktop VM, comma separated (default: cua). `agent-desktop` is the other one (it ships in the same image).
# @public @required=false
ZETTA_VM_DRIVERS=

# Systems a person may pick for a new desktop VM, comma separated (default: debian). `ubuntu` is a desktop with a terminal and no browser; its
# image must be built (docker/desktop, see its Dockerfile) and is named by ZETTA_VM_IMAGE_UBUNTU (default zetta-desktop-ubuntu:latest).
# @public @required=false
ZETTA_VM_OS=
# @public @required=false
ZETTA_VM_IMAGE_UBUNTU=

# Desktop VM image and limits (defaults: zetta-desktop:latest, 2g, 2 cpus; 4 VMs and 2 running per user, 6 running in total).
# ZETTA_VM_RUNTIME=runsc uses gVisor; ZETTA_VM_NETWORK attaches VMs to a network with host-level egress rules.
# @public @required=false
ZETTA_VM_IMAGE=
# Container CLI for VMs (default docker); e.g. /opt/podman/bin/podman.
# @public @required=false
ZETTA_DOCKER_BIN=
# @public @required=false
ZETTA_VM_MEMORY=
# @public @required=false
ZETTA_VM_CPUS=
# @public @required=false
ZETTA_VM_RUNTIME=
# @public @required=false
ZETTA_VM_NETWORK=

# Path to the agent-browser binary that drives host-mode browser sessions. Default: node_modules/.bin/agent-browser, then PATH.
# Needed when the server runs as a compiled binary. Browser containers (ZETTA_BROWSER_RUNTIME=docker) have no network of their own:
# they reach the internet only through the server's egress proxy.
# @required=false
ZETTA_AGENT_BROWSER_BIN=
# @public @required=false
ZETTA_VM_MAX_PER_USER=
# @public @required=false
ZETTA_VM_MAX_RUNNING_PER_USER=
# @public @required=false
ZETTA_VM_MAX_RUNNING=

# Code access for bots: where each user's persistent code directory lives (default ~/.zetta/code), and `off` to disable code access for every bot.
# Docker harness runs mount the code directory at /work. Bot runs have no time limit; only Stop ends them.
# @public @required=false
ZETTA_CODE_ROOT=
# @public @required=false
ZETTA_CODE_ACCESS=

# How long a bot run holds a concurrency slot (default 120000 ms). The slot limits how many runs start at once, not how long they last.
# @public @required=false
ZETTA_HARNESS_SLOT_MS=

# Skills in the server user's home (~/.claude/skills and ~/.agents/skills) can be picked with `/` in the chat for every bot. Set `on` to allow it.
# Off by default: the folders belong to one OS user, so every person who can chat with a bot would see them.
# @public @required=false
ZETTA_HOST_SKILLS=

# Company knowledge: where the local embedding model is cached (default ~/.cache/zetta/models). Set ZETTA_EMBEDDING=off for keyword search only.
# @public @required=false
ZETTA_EMBEDDING_MODEL_DIR=
# @public @required=false
ZETTA_EMBEDDING=

# Where Zetta keeps its files. Everything lives under the server user's home (~/.zetta) except the files store, which is .zetta-files in the
# server's working folder. In Docker the server's HOME and ZETTA_FILES_ROOT are on the zetta_data volume, so they survive an update.
# Authorized server files: me/<userId>/ is private, shared/ is readable by the team.
# @public @required=false
ZETTA_FILES_ROOT=
# Chat attachments (default ~/.zetta/attachments).
# @public @required=false
ZETTA_ATTACHMENTS_ROOT=
# Artifacts that people and bots publish (default ~/.zetta/artifacts).
# @public @required=false
ZETTA_ARTIFACTS_ROOT=
# Total bytes one person may keep as artifacts (default 5 GB). Nothing is deleted to make room: a publish over the limit is refused.
# @public @required=false
ZETTA_ARTIFACTS_QUOTA=
# Claude Code plugins that bots use (default ~/.zetta/claude-plugins).
# @public @required=false
ZETTA_CLAUDE_PLUGIN_ROOT=
# Playground runs (default ~/.zetta/playground).
# @public @required=false
ZETTA_PLAYGROUND_DIR=
# Browser sessions of bots in host mode (default .zetta-browser in the working folder), and the tokens of desktop VMs (default .zetta-vm).
# @public @required=false
ZETTA_BROWSER_ROOT=
# @public @required=false
ZETTA_VM_TOKEN_ROOT=

# Where bot turns run. By default the agent CLI (Claude Code, Codex...) runs on the server itself, as the server user, with that user's login.
# ZETTA_HARNESS_RUNTIME=docker runs every turn in a throwaway, hardened container instead; it needs a container runtime the server can reach.
# @public @required=false
ZETTA_HARNESS_RUNTIME=
# Image of those containers (default zetta-harness:latest, built from docker/harness) and the limits of each one (defaults: 1 cpu, 1g of
# memory, 256 processes, network bridge).
# @public @required=false
ZETTA_HARNESS_IMAGE=
# @public @required=false
ZETTA_HARNESS_CPUS=
# @public @required=false
ZETTA_HARNESS_MEMORY=
# @public @required=false
ZETTA_HARNESS_PIDS=
# @public @required=false
ZETTA_HARNESS_NETWORK=
# The container command that runs harness, browser and playground containers. Zetta picks docker or podman itself: set this when its answer
# is wrong or the binary cannot be run here. ZETTA_CONTAINER_USER is the uid:gid they run as (default: the server user's, or 10001:10001
# where there is no uid).
# @public @required=false
ZETTA_CONTAINER_ENGINE=
# @public @required=false
ZETTA_CONTAINER_USER=
# Gives every person their own HOME for each agent CLI, so their logins and sessions are not shared. Unset: everyone uses the login of the
# server user.
# @public @required=false
ZETTA_HARNESS_HOME_ROOT=
# How many bot runs go at once (default 8 in total, 4 per person) and how long a run waits for a free slot (default 300000 ms).
# @public @required=false
ZETTA_HARNESS_MAX=
# @public @required=false
ZETTA_HARNESS_MAX_PER_USER=
# @public @required=false
ZETTA_HARNESS_WAIT_MS=

# Bot browsers. ZETTA_BROWSER_RUNTIME=docker runs a bot's browser in a container; it is required once Zetta is open to the network. Image
# default zetta-browser:latest; limits default to 1 cpu, 1g of memory and 512 processes. ZETTA_CHROMIUM_PATH is the Chromium to use in host
# mode.
# @public @required=false
ZETTA_BROWSER_RUNTIME=
# @public @required=false
ZETTA_BROWSER_IMAGE=
# @public @required=false
ZETTA_BROWSER_CPUS=
# @public @required=false
ZETTA_BROWSER_MEMORY=
# @public @required=false
ZETTA_BROWSER_PIDS=
# @public @required=false
ZETTA_CHROMIUM_PATH=

# Playground containers: limits default to 2 cpus, 1g of memory and 256 processes. ZETTA_PLAYGROUND_NETWORK=none closes the network.
# @public @required=false
ZETTA_PLAYGROUND_CPUS=
# @public @required=false
ZETTA_PLAYGROUND_MEMORY=
# @public @required=false
ZETTA_PLAYGROUND_PIDS=
# @public @required=false
ZETTA_PLAYGROUND_NETWORK=
# Desktop VM limits that ZETTA_VM_MEMORY and ZETTA_VM_CPUS do not cover: processes (default 1024) and shared memory (default 1g).
# @public @required=false
ZETTA_VM_PIDS=
# @public @required=false
ZETTA_VM_SHM=

# Several servers on one database (docs/operations/scaling.md). ZETTA_ROLE is what this process does: all (default), api (serves requests, never
# starts bot turns) or worker. ZETTA_EVENT_BUS is how live updates reach the other servers: local (default for all) or pg (default otherwise).
# @public @required=false
ZETTA_ROLE=
# @public @required=false
ZETTA_EVENT_BUS=
# The name this server instance goes by; unset: Zetta chooses one.
# @public @required=false
ZETTA_INSTANCE_NAME=
# Timing between server instances, in milliseconds: how often one reports it is alive (default 10000), how long without a report before it is
# treated as dead (default 90000) and the recovery timing (default 60000). Leave the defaults unless you run several instances and need it.
# @public @required=false
ZETTA_HEARTBEAT_MS=
# @public @required=false
ZETTA_INSTANCE_DEAD_AFTER_MS=
# @public @required=false
ZETTA_FENCE_AFTER_MS=
# How often the live-updates stream sends a keep-alive, in milliseconds (default 30000). Lower it when a proxy closes idle streams.
# @public @required=false
ZETTA_SSE_HEARTBEAT_MS=
# Room turns that run at once (default 4), and how long a room turn may go without progress before it counts as stuck (default 600000 ms).
# @public @required=false
ZETTA_ROOM_CONCURRENCY=
# @public @required=false
ZETTA_ROOM_STUCK_MS=
# The address the server uses to call its own API (default http://127.0.0.1:<PORT>).
# @public @required=false
ZETTA_INTERNAL_URL=

# Sign-in and secrets. ZETTA_AUTH_RATE_LIMIT_STORAGE=database keeps the sign-in rate-limit counters in the database so several servers share
# them; unset, each server counts on its own.
# @public @required=false
ZETTA_AUTH_RATE_LIMIT_STORAGE=
# The label of the connection key (default v1). Change it only when you rotate the key.
# @public @required=false
ZETTA_CONNECTION_KEY_ID=
# The base of the return addresses that plugins with OAuth (Google, Reddit...) use. Default: ZETTA_SERVER_URL.
# @public @required=false
ZETTA_OAUTH_REDIRECT_BASE=

# Features. ZETTA_LAYA_PRELOAD=0 loads the Laya model on first use instead of at boot. ZETTA_MEMORY_LEARN=off stops bots from learning into
# memory on their own (ZETTA_WIKI_LEARN is its old name).
# @public @required=false
ZETTA_LAYA_PRELOAD=
# @public @required=false
ZETTA_MEMORY_LEARN=
# @public @required=false
ZETTA_WIKI_LEARN=
# Local (stdio) MCP servers: ZETTA_MCP_ALLOWLIST lists the ones an administrator allows, separated by `;`, each a command with its arguments
# separated by spaces (no shell). ZETTA_MCP_MEMBER_STDIO=1 (the default) lets members, not only the administrator, run them.
# @public @required=false
ZETTA_MCP_ALLOWLIST=
# @public @required=false
ZETTA_MCP_MEMBER_STDIO=
# Speech to text on the server. ZETTA_TRANSCRIBE=off turns it off. The local provider uses ZETTA_TRANSCRIBE_MODEL (a Whisper model), a
# language passed to it for voice notes (ZETTA_TRANSCRIBE_LANGUAGE) and keeps the downloaded model in ZETTA_TRANSCRIBE_MODEL_DIR (default
# ~/.cache/zetta/models; copy the files there to work offline).
# @public @required=false
ZETTA_TRANSCRIBE=
# @public @required=false
ZETTA_TRANSCRIBE_MODEL=
# @public @required=false
ZETTA_TRANSCRIBE_LANGUAGE=
# @public @required=false
ZETTA_TRANSCRIBE_MODEL_DIR=
