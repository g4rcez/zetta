# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Encryption key for stored secrets and proof of ownership at first-run onboarding: base64 of 32 random bytes (`openssl rand -base64 32`).
# @type=string(minLength=44, maxLength=44)
ZETTA_CONNECTION_KEY=

# Listen address override. Default: 127.0.0.1, or 0.0.0.0 once onboarding opened Zetta to the network. Containers set 0.0.0.0.
# @public @required=false
ZETTA_HOST=

# WhatsApp (WAHA) server that users pair with a QR code. Default URL: http://127.0.0.1:3010. Key: the container's WAHA_API_KEY.
# @public @required=false
ZETTA_WAHA_URL=
# @required=false
ZETTA_WAHA_API_KEY=

# Bot databases (each bot's private Postgres schema). Bot passwords are derived from this key (falls back to ZETTA_CONNECTION_KEY);
# the app's database user needs CREATEROLE. Quota per bot in MB (default 50).
# @required=false
ZETTA_BOT_DATABASE_KEY=
# @public @required=false
ZETTA_BOT_DATABASE_QUOTA_MB=

# @public @required=false
ZETTA_ALLOW_PRIVATE_NETWORK=

# Per-user Linux desktops ("VMs"): `docker` runs docker/desktop (cua-spacesd) per VM; `cua` uses the older Cua Spaces CLI.
# @public @required=false
ZETTA_DESKTOP_RUNTIME=

# Desktop VM image and limits (defaults: zetta-desktop:latest, 2g, 2 cpus; 4 VMs and 2 running per user, 6 running in total).
# ZETTA_VM_RUNTIME=runsc uses gVisor; ZETTA_VM_NETWORK attaches VMs to a network with host-level egress rules.
# @public @required=false
ZETTA_VM_IMAGE=
# Container CLI for VMs (default docker); e.g. /opt/podman/bin/podman.
# @public @required=false
ZETTA_DOCKER_BIN=
# @public @required=false
ZETTA_VM_MEMORY=
# @public @required=false
ZETTA_VM_CPUS=
# @public @required=false
ZETTA_VM_RUNTIME=
# @public @required=false
ZETTA_VM_NETWORK=
# @public @required=false
ZETTA_VM_MAX_PER_USER=
# @public @required=false
ZETTA_VM_MAX_RUNNING_PER_USER=
# @public @required=false
ZETTA_VM_MAX_RUNNING=

# Code access for bots: where each user's persistent code workspace lives (default ~/.zetta/code), and `off` to disable code access for every bot.
# Docker harness runs mount the workspace at /work. Bot runs have no time limit; only Stop ends them.
# @public @required=false
ZETTA_CODE_ROOT=
# @public @required=false
ZETTA_CODE_ACCESS=

# How long a bot run holds a concurrency slot (default 120000 ms). The slot limits how many runs start at once, not how long they last.
# @public @required=false
ZETTA_HARNESS_SLOT_MS=
