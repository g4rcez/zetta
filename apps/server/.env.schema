# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Encryption key for stored secrets and proof of ownership at first-run onboarding: base64 of 32 random bytes (`openssl rand -base64 32`).
# @type=string(minLength=44, maxLength=44)
ZETTA_CONNECTION_KEY=

# One-time key typed in the browser at first-run onboarding. Use a value different from ZETTA_CONNECTION_KEY (`openssl rand -base64 32`):
# the connection key then never leaves the server. When unset, onboarding asks for ZETTA_CONNECTION_KEY.
# @required=false
ZETTA_SETUP_KEY=

# Session cookie SameSite: none (default, the desktop app needs it), lax or strict. A web-only install should use lax.
# @required=false
ZETTA_COOKIE_SAMESITE=

# Header your reverse proxy sets with the real client address (for example x-forwarded-for or cf-connecting-ip); sign-in rate limits count
# per that address. Unset: the socket address is used. Only set it when the proxy always overwrites or appends the header.
# @required=false
ZETTA_TRUSTED_IP_HEADER=

# Listen address override. Default: 127.0.0.1, or 0.0.0.0 once onboarding opened Zetta to the network. Containers set 0.0.0.0.
# @public @required=false
ZETTA_HOST=

# HTTPS: PEM certificate and private key paths (relative to apps/server). Set both or neither; `bun run certs` creates a local pair.
# Then use https:// in BETTER_AUTH_URL. MCP clients sign in with OAuth, which needs HTTPS off loopback.
# @public @required=false
ZETTA_TLS_CERT=
# @public @required=false
ZETTA_TLS_KEY=
# Extra root certificate Bun trusts, for a local CA such as mkcert's (`bun run certs` copies it to .certs/rootCA.pem). The server calls its own
# HTTPS URL to verify MCP access tokens. Bun reads it only at process start: `bun dev` passes it from here, other launchers must export it.
# @public @required=false
NODE_EXTRA_CA_CERTS=

# WhatsApp (WAHA) server that users pair with a QR code. Default URL: http://127.0.0.1:3010. Key: the container's WAHA_API_KEY.
# @public @required=false
ZETTA_WAHA_URL=
# @required=false
ZETTA_WAHA_API_KEY=

# Bot databases (each bot's private Postgres schema). Bot passwords are derived from this key (falls back to ZETTA_CONNECTION_KEY);
# the app's database user needs CREATEROLE. Quota per bot in MB (default 50).
# @required=false
ZETTA_BOT_DATABASE_KEY=
# @public @required=false
ZETTA_BOT_DATABASE_QUOTA_MB=

# Max connections in the app's Postgres pool (default 20). Keep the sum over all server instances below Postgres's max_connections.
# @public @required=false
ZETTA_DB_POOL_MAX=

# @public @required=false
ZETTA_ALLOW_PRIVATE_NETWORK=

# Per-user Linux desktops ("VMs"): `docker` runs docker/desktop per VM.
# @public @required=false
ZETTA_DESKTOP_RUNTIME=

# Desktop VM image and limits (defaults: zetta-desktop:latest, 2g, 2 cpus; 4 VMs and 2 running per user, 6 running in total).
# ZETTA_VM_RUNTIME=runsc uses gVisor; ZETTA_VM_NETWORK attaches VMs to a network with host-level egress rules.
# @public @required=false
ZETTA_VM_IMAGE=
# Container CLI for VMs (default docker); e.g. /opt/podman/bin/podman.
# @public @required=false
ZETTA_DOCKER_BIN=
# @public @required=false
ZETTA_VM_MEMORY=
# @public @required=false
ZETTA_VM_CPUS=
# @public @required=false
ZETTA_VM_RUNTIME=
# @public @required=false
ZETTA_VM_NETWORK=

# Path to the agent-browser binary that drives host-mode browser sessions. Default: node_modules/.bin/agent-browser, then PATH.
# Needed when the server runs as a compiled binary. Browser containers (ZETTA_BROWSER_RUNTIME=docker) have no network of their own:
# they reach the internet only through the server's egress proxy.
# @required=false
ZETTA_AGENT_BROWSER_BIN=
# @public @required=false
ZETTA_VM_MAX_PER_USER=
# @public @required=false
ZETTA_VM_MAX_RUNNING_PER_USER=
# @public @required=false
ZETTA_VM_MAX_RUNNING=

# Code access for bots: where each user's persistent code workspace lives (default ~/.zetta/code), and `off` to disable code access for every bot.
# Docker harness runs mount the workspace at /work. Bot runs have no time limit; only Stop ends them.
# @public @required=false
ZETTA_CODE_ROOT=
# @public @required=false
ZETTA_CODE_ACCESS=

# How long a bot run holds a concurrency slot (default 120000 ms). The slot limits how many runs start at once, not how long they last.
# @public @required=false
ZETTA_HARNESS_SLOT_MS=

# Company knowledge: where the local embedding model is cached (default ~/.cache/zetta/models). Set ZETTA_EMBEDDING=off for keyword search only.
# @public @required=false
ZETTA_EMBEDDING_MODEL_DIR=
# @public @required=false
ZETTA_EMBEDDING=
