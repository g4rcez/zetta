{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun scripts/compile.ts",
    "start": "bun run dist/index.mjs",
    "dev:server": "varlock run -- bun run --hot src/index.ts",
    "dev:bare": "bun run --hot src/index.ts",
    "connections:rotate-user-key": "varlock run -- bun run src/scripts/rotate-user-key.ts",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@sinclair/typebox": "^0.34.52",
    "@zetta/auth": "workspace:*",
    "@zetta/core": "workspace:*",
    "@zetta/db": "workspace:*",
    "@zetta/harness": "workspace:*",
    "@zetta/laya": "workspace:*",
    "@zetta/render": "workspace:*",
    "agent-browser": "0.41.0",
    "ai": "^7.0.153",
    "better-auth": "catalog:",
    "chrono-node": "^2.10.3",
    "elysia": "^1.4.30",
    "evlog": "^2.30.1",
    "imapflow": "^2.9.1",
    "node-schedule": "^2.1.2",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/imapflow": "^1.0.189",
    "@types/node-schedule": "^2.1.8",
    "@zetta/config": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
