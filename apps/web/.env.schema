# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# The one public address of Zetta (the same value as in apps/server/.env): the web app and the API answer on it.
# @public @type=url
ZETTA_SERVER_URL=

# HTTPS for the dev server: PEM certificate and private key paths (relative to apps/web). Set both or neither; `bun run certs` creates a pair.
# @required=false
ZETTA_TLS_CERT=
# @required=false
ZETTA_TLS_KEY=

# Listen address of the dev server. Default: this computer only. `bun run setup -- --mode lan` sets 0.0.0.0 to open it to the local network.
# @public @required=false
ZETTA_HOST=
