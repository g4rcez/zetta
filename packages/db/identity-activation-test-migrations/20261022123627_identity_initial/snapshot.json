    {
      "value": "\"event_kind\" in ('bootstrap', 'admin-replacement', 'invite-issued', 'invite-revoked', 'invite-consumed')",
      "name": "identity_audit_event_kind_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "identity_audit"
    },
    {
      "value": "\"actor_kind\" in ('operator', 'user')",
      "name": "identity_audit_actor_kind_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "identity_audit"
    },
    {
      "value": "\n      (\"actor_kind\" = 'operator' and \"actor_user_id\" is null)\n      or (\"actor_kind\" = 'user' and \"actor_user_id\" is not null)\n    ",
      "name": "identity_audit_actor_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "identity_audit"
    },
    {
      "value": "\n      \"event_kind\" <> 'admin-replacement'\n      or (\"actor_kind\" = 'operator' and \"operator_reason\" is not null and length(btrim(\"operator_reason\")) > 0)\n    ",
      "name": "identity_audit_replacement_reason_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "identity_audit"
    },
    {
      "value": "\"id\" = 1",
      "name": "installation_identity_singleton_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "installation_identity"
    },
    {
      "value": "\"admin_membership_status\" = 'active'",
      "name": "installation_identity_admin_active_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "installation_identity"
    },
    {
      "value": "\"intended_email\" = lower(\"intended_email\")",
      "name": "invitation_email_canonical_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "invitation"
    },
    {
      "value": "\"expires_at\" > \"created_at\"",
      "name": "invitation_expiry_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "invitation"
    },
    {
      "value": "(\"consumed_at\" is null) = (\"consumed_by_user_id\" is null)",
      "name": "invitation_consumption_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "invitation"
    },
    {
      "value": "\"status\" in ('active', 'removed')",
      "name": "membership_status_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "membership"
    },
    {
      "value": "\n      (\"status\" = 'active' and \"removed_at\" is null)\n      or (\"status\" = 'removed' and \"removed_at\" is not null)\n    ",
      "name": "membership_removal_check",
      "entityType": "checks",
      "schema": "zetta",
      "table": "membership"
    }
