    {
      "value": "\"generation\" between 1 and 2147483647",
      "name": "run_attempts_generation_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "\"status\" in ('queued','running','succeeded','failed','cancelled','interrupted')",
      "name": "run_attempts_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "\"effect_state\" in ('no_effect','known','uncertain')",
      "name": "run_attempts_effect_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "(\"lease_id\" is null and \"lease_expires_at\" is null and \"claimed_at\" is null)\n    or (\"lease_id\" is not null and \"lease_expires_at\" is not null and \"claimed_at\" is not null and \"lease_expires_at\" > \"claimed_at\")",
      "name": "run_attempts_lease_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "\n    (\"status\" = 'queued' and \"effect_state\" = 'no_effect' and \"lease_id\" is null and \"started_at\" is null\n      and \"finished_at\" is null and \"stop_confirmed_at\" is null and \"result_version\" is null and \"cancellation_reason\" is null)\n    or (\"status\" = 'running' and \"effect_state\" in ('no_effect','uncertain') and \"lease_id\" is not null\n      and \"finished_at\" is null and \"result_version\" is null)\n    or (\"status\" in ('succeeded','failed','cancelled','interrupted') and \"finished_at\" is not null)",
      "name": "run_attempts_lifecycle_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "(\"result_version\" is null and \"result_text\" is null and \"result_error_code\" is null and \"result_last_sequence\" is null)\n    or (\"result_version\" is not null and \"result_version\" = 1 and \"result_text\" is not null and octet_length(\"result_text\") <= 65536\n      and \"result_last_sequence\" is not null and \"result_last_sequence\" between 0 and 1000)",
      "name": "run_attempts_result_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "\"result_error_code\" is null or \"result_error_code\" in\n    ('invalid_input','unsupported','malformed_output','out_of_order','output_limit','tool_denied','tool_failed','outcome_uncertain','deadline','adapter_failed')",
      "name": "run_attempts_error_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "\"cancellation_reason\" is null or (\"cancellation_reason\" = 'owner_requested' and \"status\" in ('running','cancelled'))",
      "name": "run_attempts_cancellation_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "(\"claimed_at\" is null or \"claimed_at\" >= \"created_at\")\n    and (\"started_at\" is null or (\"claimed_at\" is not null and \"started_at\" >= \"claimed_at\"))\n    and (\"finished_at\" is null or (\"finished_at\" >= \"created_at\"\n      and (\"claimed_at\" is null or \"finished_at\" >= \"claimed_at\")\n      and (\"started_at\" is null or \"finished_at\" >= \"started_at\")))\n    and (\"stop_confirmed_at\" is null or (\"stop_confirmed_at\" >= \"created_at\"\n      and (\"claimed_at\" is null or \"stop_confirmed_at\" >= \"claimed_at\")\n      and (\"started_at\" is null or \"stop_confirmed_at\" >= \"started_at\")))",
      "name": "run_attempts_time_check",
      "entityType": "checks",
      "schema": "public",
      "table": "run_attempts"
    },
    {
      "value": "\"owner_user_id\" collate \"C\" ~ '^[a-zA-Z0-9_-]{1,128}$'\n    and \"bot_id\" collate \"C\" ~ '^[a-zA-Z0-9_-]{1,128}$' and \"conversation_id\" collate \"C\" ~ '^[a-zA-Z0-9_-]{1,128}$'\n    and \"configuration_id\" collate \"C\" ~ '^[a-zA-Z0-9_-]{1,128}$'",
      "name": "runs_identifiers_check",
      "entityType": "checks",
      "schema": "public",
      "table": "runs"
    },
    {
      "value": "\"origin_kind\" in ('interactive','setup')",
      "name": "runs_origin_check",
      "entityType": "checks",
      "schema": "public",
      "table": "runs"
    },
    {
      "value": "\"configuration_version\" between 1 and 2147483647 and \"revision\" between 1 and 2147483647 and \"current_generation\" between 1 and 2147483647",
      "name": "runs_counters_check",
      "entityType": "checks",
      "schema": "public",
      "table": "runs"
    },
    {
      "value": "\"input_version\" = 1 and octet_length(\"input_snapshot\") between 1 and 98304 and \"input_snapshot\" is json array",
      "name": "runs_input_check",
      "entityType": "checks",
      "schema": "public",
      "table": "runs"
    },
    {
      "value": "(\"producer_kind\" is null and \"producer_version\" is null and \"actor_activation_revision\" is null)\n    or (\"producer_kind\" is not null and \"producer_version\" is not null and \"actor_activation_revision\" is not null\n      and \"producer_kind\" = 'fixture' and \"producer_version\" = 1 and \"actor_activation_revision\" between 1 and 2147483647)",
      "name": "runs_producer_check",
      "entityType": "checks",
      "schema": "public",
      "table": "runs"
    },
    {
      "value": "\"status\" in ('queued','running','succeeded','failed','cancelled','interrupted')",
      "name": "runs_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "runs"
    },
    {
      "value": "\n    (\"status\" = 'queued' and \"started_at\" is null and \"finished_at\" is null and \"cancel_requested_at\" is null)\n    or (\"status\" = 'running' and \"finished_at\" is null)\n    or (\"status\" in ('succeeded','failed','cancelled','interrupted') and \"finished_at\" is not null)",
      "name": "runs_lifecycle_check",
      "entityType": "checks",
      "schema": "public",
      "table": "runs"
    },
    {
      "value": "(\"started_at\" is null or \"started_at\" >= \"created_at\")\n    and (\"cancel_requested_at\" is null or \"cancel_requested_at\" >= \"created_at\")\n    and (\"finished_at\" is null or (\"finished_at\" >= \"created_at\"\n      and (\"started_at\" is null or \"finished_at\" >= \"started_at\")\n      and (\"cancel_requested_at\" is null or \"finished_at\" >= \"cancel_requested_at\")))",
      "name": "runs_time_check",
      "entityType": "checks",
      "schema": "public",
      "table": "runs"
    }
  ],
  "renames": []
