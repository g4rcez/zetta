# @import(../../apps/server/, pick=[NODE_ENV, NODE_EXTRA_CA_CERTS])
# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# Where `bun run infra` deploys (docs/operations/vps.md). Put the values in the untracked packages/infra/.env.<environment>.
# The server's IP address or name for SSH, and the domain people open (its DNS record points at that server).
DEPLOY_HOST=
DEPLOY_DOMAIN=
# Your admin user on the server (default deploy), the SSH port (default 22) and the private key (default: what ssh would use).
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=
DEPLOY_SSH_KEY=
# Where Let's Encrypt sends certificate notices. Optional.
DEPLOY_ACME_EMAIL=
